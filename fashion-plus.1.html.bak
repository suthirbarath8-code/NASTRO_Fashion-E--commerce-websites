<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Fashion+ New World</title>
  <style>
    :root {
      --bg: #ffffff;
      --ink: #14201f;
      --mute: #5d6a68;
      --line: #e3e6e4;
      --card: #f4f5f3;
      --acc: #f26a1b;
      --teal: #0f7f74;
      --c1: #f26a1b;
      box-sizing: border-box;
      padding-top: env(safe-area-inset-top, 0px);
      padding-bottom: env(safe-area-inset-bottom, 0px)
    }

    @media (prefers-color-scheme:dark) {
      :root:not([data-theme="light"]) {
        --bg: #111716;
        --ink: #f3f1ec;
        --mute: #9aa6a3;
        --line: #26302e;
        --card: #1a2321
      }
    }

    * {
      box-sizing: border-box;
      margin: 0
    }

    html {
      scroll-padding-top: env(safe-area-inset-top, 0px);
      scroll-behavior: smooth
    }

    body {
      background: var(--bg);
      color: var(--ink);
      font-family: "Archivo", "Helvetica Neue", Arial, sans-serif;
      overflow-x: hidden
    }

    a {
      color: inherit;
      text-decoration: none
    }

    button {
      font: inherit;
      color: inherit;
      cursor: pointer;
      background: none;
      border: 0
    }

    :focus-visible {
      outline: 2px solid var(--acc);
      outline-offset: 3px
    }

    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 22px 5vw;
      border-bottom: 1px solid var(--line)
    }

    .logo {
      font-weight: 800;
      font-size: 22px;
      letter-spacing: .04em
    }

    .logo small {
      display: block;
      font-size: 8px;
      letter-spacing: .3em;
      color: var(--mute);
      font-weight: 500
    }

    nav {
      display: flex;
      gap: 28px;
      font-size: 13px
    }

    nav a {
      padding: 4px 0;
      border-bottom: 2px solid transparent
    }

    nav a:hover,
    nav a.on {
      border-color: var(--acc)
    }

    .icons {
      display: flex;
      gap: 16px;
      align-items: center
    }

    .icons button {
      position: relative;
      font-size: 18px;
      width: 32px;
      height: 32px
    }

    #count {
      position: absolute;
      top: -2px;
      right: -4px;
      background: var(--acc);
      color: #fff;
      border-radius: 50%;
      font-size: 10px;
      width: 16px;
      height: 16px;
      display: grid;
      place-items: center
    }

    #menuBtn {
      display: none
    }

    .hero {
      position: relative;
      min-height: 640px;
      padding: 60px 5vw;
      overflow: hidden;
      display: grid;
      align-items: end
    }

    .tag {
      position: absolute;
      top: 36px;
      left: 5vw;
      font-size: 12px;
      color: var(--mute);
      display: flex;
      gap: 10px;
      align-items: center
    }

    .tag i {
      width: 28px;
      height: 1px;
      background: var(--acc)
    }

    .big {
      position: absolute;
      left: 0;
      right: 0;
      top: 70px;
      text-align: center;
      font-size: clamp(90px, 19vw, 270px);
      font-weight: 900;
      font-style: italic;
      letter-spacing: -.03em;
      line-height: 1;
      color: var(--ink);
      opacity: .92;
      font-stretch: 125%
    }

    .hero {
      background-color: var(--c1);
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      color: #fff;
      transition: background-color .6s ease
    }

    .hero::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, rgba(0, 0, 0, .5), rgba(0, 0, 0, .1));
      pointer-events: none
    }

    .hero .tag,
    .hero .copy p,
    .hero .perks,
    .hero .side {
      color: rgba(255, 255, 255, .88)
    }

    .hero .tag i {
      background: #fff
    }

    .hero .big {
      color: #fff;
      opacity: .9
    }

    .hero .btn {
      background: #fff;
      color: #14201f
    }

    .hero .side a.on {
      color: #fff;
      border-bottom-color: #fff
    }

    .hero .thumb.on {
      border-color: #fff
    }

    .hero .arrows button {
      background: rgba(255, 255, 255, .18);
      border-color: rgba(255, 255, 255, .45);
      color: #fff
    }

    .hero .model.noimg {
      border-color: rgba(255, 255, 255, .7);
      color: #fff;
      background: rgba(255, 255, 255, .12)
    }

    .model {
      position: absolute;
      left: 50%;
      bottom: 0;
      transform: translateX(-50%);
      width: min(34vw, 300px);
      height: 76%;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      text-align: center;
      color: var(--mute);
      font-size: 13px
    }

    .model img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: bottom;
      display: block
    }

    .model .ph-text {
      display: none
    }

    .model.noimg {
      border: 2px dashed var(--mute);
      border-radius: 140px 140px 8px 8px;
      align-items: center;
      background: color-mix(in srgb, var(--bg) 70%, transparent)
    }

    .model.noimg img {
      display: none
    }

    .model.noimg .ph-text {
      display: block
    }

    .copy {
      position: relative;
      z-index: 2;
      max-width: 340px
    }

    .copy h1 {
      font-size: clamp(30px, 4vw, 46px);
      font-weight: 800;
      line-height: 1.02;
      letter-spacing: .01em;
      text-transform: uppercase;
      margin-bottom: 16px
    }

    .copy p {
      font-size: 13px;
      color: var(--mute);
      margin-bottom: 22px;
      max-width: 260px
    }

    .btn {
      display: inline-flex;
      gap: 8px;
      align-items: center;
      background: var(--ink);
      color: var(--bg);
      border-radius: 30px;
      padding: 12px 22px;
      font-size: 12px;
      font-weight: 700
    }

    .perks {
      display: flex;
      gap: 24px;
      margin-top: 40px;
      font-size: 11px;
      color: var(--mute)
    }

    .side {
      position: absolute;
      right: 5vw;
      top: 36px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      text-align: right;
      font-size: 11px;
      color: var(--mute)
    }

    .side a.on {
      color: var(--acc);
      border-bottom: 1px solid var(--acc)
    }

    .thumbs {
      position: absolute;
      right: 5vw;
      bottom: 60px;
      width: 130px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      z-index: 2
    }

    .thumb {
      height: 78px;
      border-radius: 12px;
      border: 2px solid transparent;
      display: grid;
      place-items: center;
      font-size: 11px;
      font-weight: 700;
      color: #fff;
      transition: .2s;
      background-size: cover;
      background-position: center;
      text-shadow: 0 1px 4px rgba(0, 0, 0, .7)
    }

    .thumb.on {
      border-color: var(--ink);
      transform: scale(1.05)
    }

    .arrows {
      display: flex;
      gap: 10px;
      justify-content: center
    }

    .arrows button {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: var(--card);
      border: 1px solid var(--line)
    }

    .counter {
      position: absolute;
      right: 5vw;
      top: 48%;
      font-size: 22px;
      font-weight: 800;
      display: none
    }

    .contact {
      position: fixed;
      right: 0;
      top: 90px;
      writing-mode: vertical-rl;
      background: var(--ink);
      color: var(--bg);
      padding: 16px 8px;
      border-radius: 12px 0 0 12px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .1em;
      z-index: 20
    }

    section {
      padding: 80px 5vw
    }

    .sh {
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 20px;
      margin-bottom: 34px;
      flex-wrap: wrap
    }

    .sh h2 {
      font-size: clamp(30px, 5vw, 56px);
      font-weight: 900;
      text-transform: uppercase;
      line-height: .95
    }

    .sh p {
      font-size: 13px;
      color: var(--mute);
      max-width: 260px;
      text-align: right
    }

    .cats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px
    }

    .cat {
      height: 240px;
      border-radius: 18px;
      padding: 20px;
      display: flex;
      align-items: end;
      font-weight: 800;
      font-size: 20px;
      color: #fff;
      transition: transform .2s
    }

    .cat:hover {
      transform: translateY(-4px)
    }

    .chips {
      display: flex;
      gap: 8px;
      margin-bottom: 24px;
      flex-wrap: wrap
    }

    .chip {
      padding: 8px 16px;
      border-radius: 20px;
      border: 1px solid var(--line);
      font-size: 12px
    }

    .chip.on {
      background: var(--ink);
      color: var(--bg)
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
      gap: 20px
    }

    .card .ph {
      height: 260px;
      border-radius: 16px;
      background: var(--card);
      display: grid;
      place-items: center;
      color: var(--mute);
      font-size: 12px;
      margin-bottom: 12px
    }

    .card h3 {
      font-size: 14px
    }

    .card span {
      font-size: 13px;
      color: var(--mute)
    }

    .card .add {
      margin-top: 10px;
      width: 100%;
      padding: 10px;
      border-radius: 24px;
      border: 1px solid var(--ink);
      font-size: 12px;
      font-weight: 700
    }

    .card .add:hover {
      background: var(--ink);
      color: var(--bg)
    }

    .news {
      background: var(--card);
      border-radius: 24px;
      margin: 0 5vw 60px;
      padding: 50px;
      display: flex;
      justify-content: space-between;
      gap: 24px;
      flex-wrap: wrap;
      align-items: center
    }

    .news h2 {
      font-size: 30px;
      font-weight: 900;
      text-transform: uppercase
    }

    .news div {
      display: flex;
      gap: 8px
    }

    .news input {
      padding: 12px 18px;
      border-radius: 30px;
      border: 1px solid var(--line);
      background: var(--bg);
      color: var(--ink);
      min-width: 220px
    }

    footer {
      padding: 30px 5vw;
      border-top: 1px solid var(--line);
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      color: var(--mute);
      flex-wrap: wrap;
      gap: 10px
    }

    .toast {
      position: fixed;
      left: 50%;
      bottom: 24px;
      transform: translate(-50%, 80px);
      background: var(--ink);
      color: var(--bg);
      padding: 12px 20px;
      border-radius: 30px;
      font-size: 13px;
      transition: .3s;
      z-index: 30
    }

    .toast.show {
      transform: translate(-50%, 0)
    }

    @media(max-width:820px) {
      nav {
        display: none;
        position: absolute;
        top: 70px;
        left: 0;
        right: 0;
        background: var(--bg);
        flex-direction: column;
        padding: 20px 5vw;
        border-bottom: 1px solid var(--line);
        z-index: 15
      }

      nav.open {
        display: flex
      }

      #menuBtn {
        display: grid
      }

      .side {
        display: none
      }

      .model {
        width: 50vw;
        height: 58%
      }

      .thumbs {
        flex-direction: row;
        width: auto;
        bottom: 16px
      }

      .thumb {
        width: 64px;
        height: 64px
      }

      .arrows {
        display: none
      }

      .hero {
        padding-bottom: 110px
      }

      .perks {
        flex-wrap: wrap;
        gap: 12px
      }

      .copy {
        margin-bottom: 60px;
        max-width: 200px
      }

      .sh p {
        text-align: left
      }
    }

    @media(prefers-reduced-motion:reduce) {
      * {
        transition: none !important;
        scroll-behavior: auto !important
      }
    }
  </style>
</head>

<body>
  <header>
    <a class="logo" href="#top">Fashion+<small>NEW WORLD</small></a>
    <nav id="nav">
      <a href="#shop" class="on">Shop</a><a href="#shop" data-f="Women">Women</a><a href="#shop" data-f="Men">Men</a><a
        href="#shop" data-f="Sunglass">Sunglass</a><a href="#cats">Collections</a><a href="#about">About</a>
    </nav>
    <div class="icons">
      <button aria-label="Search" id="searchBtn">&#9906;</button>
      <button aria-label="Account" id="userBtn">&#9786;</button>
      <button aria-label="Cart" id="cartBtn">&#128717;<b id="count">0</b></button>
      <button aria-label="Menu" id="menuBtn">&#9776;</button>
    </div>
  </header>

  <main id="top">
    <div class="hero" id="hero">
      <div class="tag"><span id="season">RE</span><i></i><span>New season</span></div>
      <div class="big" aria-hidden="true">FASHION</div>
      <div class="model" id="model">
        <img id="modelImg" src="Fashion%20Model%20and%20Orange%20Disc%20Cutouts.png"
          alt="Model wearing Fashion+ apparel" onerror="this.parentNode.classList.add('noimg')">
        <span class="ph-text">Add your image at<br>Fashion%20Model%20and%20Orange%20Disc%20Cutouts.png</span>
      </div>
      <div class="copy">
        <h1 id="title">Style in motion</h1>
        <p id="sub">Performance apparel, footwear and gear for a stronger, more confident game.</p>
        <a class="btn" href="#shop">Shop now &rarr;</a>
        <div class="perks"><span>Premium quality</span><span>Free shipping</span><span>Easy returns</span></div>
      </div>
      <div class="thumbs">
        <div id="thumbList"></div>
        <div class="arrows"><button id="prev" aria-label="Previous">&larr;</button><button id="next"
            aria-label="Next">&rarr;</button></div>
      </div>
    </div>

    <section id="cats">
      <div class="sh">
        <h2>Shop by<br>category</h2>
        <p>Designed for every product. Comfort, performance and style your world now.</p>
      </div>
      <div class="cats" id="catGrid"></div>
    </section>

    <section id="shop">
      <div class="sh">
        <h2>New arrivals</h2>
        <p id="results">Showing all products</p>
      </div>
      <div class="chips" id="chips"></div>
      <div class="grid" id="grid"></div>
    </section>

    <section id="about" style="padding-top:0">
      <div class="sh">
        <h2>About us</h2>
        <p>Fashion+ builds sportswear that moves with you, from the court to the street.</p>
      </div>
    </section>
    <div class="news">
      <h2>Join the new world</h2>
      <div><input id="email" type="email" placeholder="Your email" aria-label="Email"><button class="btn"
          id="sub-btn">Subscribe</button></div>
    </div>
  </main>
  <footer><span>&copy; 2026 Fashion+ New World</span><span>Privacy &middot; Terms &middot; Support</span></footer>
  <a class="contact" href="#about" id="contact">CONTACT US</a>
  <div class="toast" id="toast"></div>

  <script>
    const slides = [
      { t: "Style in motion", s: "Performance apparel, footwear and gear for a stronger, more confident game.", c: "#f26a1b", k: "RE", img: "Fashion%20Model%20and%20Orange%20Disc%20Cutouts.png", bg: "image_d3e255b3.jpg" ,  },
      { t: "Court ready", s: "Lightweight layers built for long rallies and quick changes.", c: "#0f7f74", k: "NEW", img:"green (2).png", bg: "green (1).png", },
      { t: "Sun on your side", s: "Sunglasses with sharp lenses and frames that stay put.", c: "#c9892b", k: "UV", img: "iii.png", bg: "i.jpg_2K_20261017150142.jpg" }];
    const cats = [["Women", "#f26a1b"], ["Men", "#0f7f74"], ["Sunglass", "#c9892b"], ["Footwear", "#d94a5b"], ["Accessories", "#3a5bd9"]];
    const prods = [["Court Dress", "Women", 64], ["Print Sundress", "Women", 58], ["Rally Tee", "Men", 32], ["Track Jacket", "Men", 78], ["Aviator Shades", "Sunglass", 45], ["Round Shades", "Sunglass", 39], ["Court Sneakers", "Footwear", 92], ["Weekend Tote", "Accessories", 36]];
    let i = 0, cart = 0, filter = "All";
    const $ = id => document.getElementById(id);
    function toast(m) { const t = $("toast"); t.textContent = m; t.classList.add("show"); clearTimeout(t._h); t._h = setTimeout(() => t.classList.remove("show"), 1800) }
    function show(n) {
      i = (n + slides.length) % slides.length; const s = slides[i];
      $("title").textContent = s.t; $("sub").textContent = s.s; $("season").textContent = s.k;
      $("hero").style.setProperty("--c1", s.c);
      $("hero").style.backgroundImage = 'url("' + s.bg + '")';
      const m = $("model"), im = $("modelImg"); m.classList.remove("noimg"); im.src = s.img;
      m.querySelector(".ph-text").innerHTML = "Add your image at<br>" + s.img;
      document.querySelectorAll(".thumb").forEach((e, j) => e.classList.toggle("on", j === i))
    }
    $("thumbList").style.cssText = "display:flex;flex-direction:column;gap:10px";
    $("prev").onclick = () => { show(i - 1); reset() }; $("next").onclick = () => { show(i + 1); reset() };
    let timer; function reset() { clearInterval(timer); timer = setInterval(() => show(i + 1),3000) }
    if (!matchMedia("(prefers-reduced-motion:reduce)").matches) reset();
    show(0);
    cats.forEach(([n, c]) => { const a = document.createElement("a"); a.className = "cat"; a.href = "#shop"; a.style.background = c; a.textContent = n; a.onclick = () => setFilter(n); $("catGrid").appendChild(a) });
    function setFilter(f) { filter = f; render() }
    function render() {
      $("chips").innerHTML = "";["All", ...cats.map(c => c[0])].forEach(f => { const b = document.createElement("button"); b.className = "chip" + (f === filter ? " on" : ""); b.textContent = f; b.onclick = () => setFilter(f); $("chips").appendChild(b) });
      const list = prods.filter(p => filter === "All" || p[1] === filter);
      $("results").textContent = list.length ? "Showing " + list.length + " product" + (list.length > 1 ? "s" : "") : "No products found. Try another category.";
      $("grid").innerHTML = ""; list.forEach(p => { const d = document.createElement("div"); d.className = "card"; d.innerHTML = `<div class="ph">Product image</div><h3>${p[0]}</h3><span>${p[1]} &middot; $${p[2]}</span><button class="add">Add to cart</button>`; d.querySelector(".add").onclick = () => { cart++; $("count").textContent = cart; toast(p[0] + " added to cart") }; $("grid").appendChild(d) })
    }
    render();
    document.querySelectorAll("nav a[data-f]").forEach(a => a.onclick = () => { setFilter(a.dataset.f); $("nav").classList.remove("open") });
    document.querySelectorAll("nav a").forEach(a => a.addEventListener("click", () => { document.querySelectorAll("nav a").forEach(x => x.classList.remove("on")); a.classList.add("on"); $("nav").classList.remove("open") }));
    $("menuBtn").onclick = () => $("nav").classList.toggle("open");
    $("searchBtn").onclick = () => { const q = prompt("Search products"); if (q === null) return; const r = prods.filter(p => p[0].toLowerCase().includes(q.toLowerCase())); filter = "All"; render(); if (!r.length) { $("results").textContent = "No products match \"" + q + "\". Try a different word."; $("grid").innerHTML = "" } else { $("grid").innerHTML = ""; r.forEach(p => { const d = document.createElement("div"); d.className = "card"; d.innerHTML = `<div class="ph">Product image</div><h3>${p[0]}</h3><span>${p[1]} &middot; $${p[2]}</span>`; $("grid").appendChild(d) }); $("results").textContent = "Search results for \"" + q + "\"" } location.hash = "#shop" };
    $("userBtn").onclick = () => toast("Sign in is not connected yet");
    $("cartBtn").onclick = () => toast(cart ? cart + " item" + (cart > 1 ? "s" : "") + " in your cart" : "Your cart is empty");
    $("sub-btn").onclick = () => { const v = $("email").value; /\S+@\S+\.\S+/.test(v) ? (toast("Subscribed"), $("email").value = "") : toast("Enter a valid email address") };
  </script>
</body>

</html>