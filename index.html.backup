<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>NOSTRA+ New World</title>
  <style>
    :root {
      --bg: #ffffff;
      --ink: #14201f;
      --mute: #5d6a68;
      --line: #e3e6e4;
      --card: #f4f5f3;
      --acc: #f26a1b;
      --teal: #0f7f74;
      --c1: #f26a1b;
      box-sizing: border-box;
      padding-top: env(safe-area-inset-top, 0px);
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }

    @media (prefers-color-scheme:dark) {
      :root:not([data-theme="light"]) {
        --bg: #111716;
        --ink: #f3f1ec;
        --mute: #9aa6a3;
        --line: #26302e;
        --card: #1a2321;
      }
    }

    * {
      box-sizing: border-box;
      margin: 0;
    }

    html {
      scroll-padding-top: env(safe-area-inset-top, 0px);
      scroll-behavior: smooth;
    }

    body {
      background: var(--bg);
      color: var(--ink);
      font-family: "Archivo", "Helvetica Neue", Arial, sans-serif;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font: inherit;
      color: inherit;
      cursor: pointer;
      background: none;
      border: 0;
    }

    :focus-visible {
      outline: 2px solid var(--acc);
      outline-offset: 3px;
    }

    /* =========================================================
       SCROLL PROGRESS BAR & MOUSE MOVING GLOW (TOP TO BOTTOM)
       ========================================================= */
    .scroll-progress-bar {
      position: fixed;
      top: 0;
      left: 0;
      height: 3px;
      width: 0%;
      background: linear-gradient(90deg, var(--acc), #0f7f74, #ffd166);
      z-index: 9999;
      pointer-events: none;
      transition: width 0.08s linear;
      box-shadow: 0 0 10px var(--acc);
    }

    .mouse-glow-follower {
      position: fixed;
      top: 0;
      left: 0;
      width: 320px;
      height: 320px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(242, 106, 27, 0.16) 0%, rgba(15, 127, 116, 0.08) 45%, transparent 70%);
      pointer-events: none;
      z-index: 9990;
      transform: translate(-50%, -50%);
      mix-blend-mode: screen;
      filter: blur(30px);
      will-change: transform;
      transition: opacity 0.3s ease;
    }

    @media (pointer: coarse) {
      .mouse-glow-follower {
        display: none !important;
      }
    }

    /* =========================================================
       TRANSPARENT NAVBAR (NO BOTTOM LINE IN ANY STATE)
       ========================================================= */
    header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 20px 5vw;
      background: transparent !important;
      color: #ffffff;
      border: none !important;
      border-bottom: none !important;
      box-shadow: none !important;
      transition: background 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                  color 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                  padding 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                  backdrop-filter 0.35s ease;
    }

    /* =========================================================
       DISTINCTIVE BRAND LOGO WITH GEOMETRIC EMBLEM
       ========================================================= */
    .logo {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 800;
      font-size: 20px;
      letter-spacing: .06em;
      color: #ffffff;
      transition: color 0.3s ease, transform 0.25s ease;
      text-shadow: 0 1px 3px rgba(0, 0, 0, 0.35);
      user-select: none;
    }

    .logo:hover {
      transform: translateY(-1px);
    }

    .logo-symbol {
      width: 34px;
      height: 34px;
      border-radius: 9px;
      background: rgba(255, 255, 255, 0.12);
      border: 1.5px solid rgba(255, 255, 255, 0.45);
      display: grid;
      place-items: center;
      color: #ffffff;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      flex-shrink: 0;
    }

    .logo:hover .logo-symbol {
      transform: rotate(6deg) scale(1.08);
      border-color: var(--acc);
      background: rgba(242, 106, 27, 0.2);
    }

    .logo-text {
      display: flex;
      flex-direction: column;
      line-height: 1.05;
    }

    .logo-plus {
      color: var(--acc);
      margin-left: 1px;
    }

    .logo small {
      display: block;
      font-size: 7.5px;
      letter-spacing: .32em;
      color: rgba(255, 255, 255, 0.85);
      font-weight: 600;
      transition: color 0.3s ease;
    }

    nav {
      display: flex;
      gap: 28px;
      font-size: 13px;
    }

    nav a {
      padding: 4px 0;
      border-bottom: 2px solid transparent;
      color: rgba(255, 255, 255, 0.9);
      transition: color 0.2s ease, border-color 0.2s ease;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
    }

    nav a:hover,
    nav a.on {
      color: #ffffff;
      border-color: #ffffff;
    }

    .icons {
      display: flex;
      gap: 12px;
      align-items: center;
    }

    .icons button {
      position: relative;
      font-size: 18px;
      width: 36px;
      height: 36px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      color: #ffffff;
      transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
    }

    .icons button:hover {
      background: rgba(255, 255, 255, 0.16);
      transform: translateY(-2px);
    }

    /* User Profile Avatar Icon Badge when signed in */
    .user-avatar-badge {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--acc), #d94a5b);
      color: #ffffff;
      font-size: 11px;
      font-weight: 800;
      display: grid;
      place-items: center;
      box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.8), 0 2px 8px rgba(0, 0, 0, 0.25);
      transition: transform 0.2s ease;
    }

    .user-avatar-badge:hover {
      transform: scale(1.1);
    }

    #count, #favCount {
      position: absolute;
      top: -2px;
      right: -3px;
      background: var(--acc);
      color: #fff;
      border-radius: 50%;
      font-size: 10px;
      font-weight: 700;
      width: 17px;
      height: 17px;
      display: grid;
      place-items: center;
      box-shadow: 0 2px 6px rgba(0,0,0,0.25);
      transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.25s ease;
      text-shadow: none;
    }

    /* SCROLLED NAVBAR STATE: TRANSPARENT GLASSMORPHISM WITH NO BOTTOM LINE */
    header.scrolled {
      background: rgba(255, 255, 255, 0.72) !important;
      color: var(--ink);
      border: none !important;
      border-bottom: none !important;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.05) !important;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      padding: 14px 5vw;
    }

    header.scrolled .logo {
      color: var(--ink);
      text-shadow: none;
    }

    header.scrolled .logo-symbol {
      background: var(--card);
      border-color: var(--line);
      color: var(--ink);
    }

    header.scrolled .logo small {
      color: var(--mute);
    }

    header.scrolled nav a {
      color: var(--ink);
      text-shadow: none;
    }

    header.scrolled nav a:hover,
    header.scrolled nav a.on {
      color: var(--acc);
      border-color: var(--acc);
    }

    header.scrolled .icons button {
      color: var(--ink);
      text-shadow: none;
    }

    header.scrolled .icons button:hover {
      background: rgba(0, 0, 0, 0.06);
    }

    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) header.scrolled {
        background: rgba(17, 23, 22, 0.72) !important;
        color: var(--ink);
        border: none !important;
        border-bottom: none !important;
      }
      :root:not([data-theme="light"]) header.scrolled .icons button:hover {
        background: rgba(255, 255, 255, 0.08);
      }
    }

    /* Mobile Menu Toggle Icon */
    #menuBtn {
      display: none;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 5px;
      width: 36px;
      height: 36px;
      padding: 6px;
    }

    .hamburger-line {
      display: block;
      width: 20px;
      height: 2px;
      background: currentColor;
      border-radius: 2px;
      transition: transform 0.3s ease, opacity 0.3s ease;
    }

    #menuBtn.active .hamburger-line:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    #menuBtn.active .hamburger-line:nth-child(2) {
      opacity: 0;
    }

    #menuBtn.active .hamburger-line:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    /* =========================================================
       HERO SECTION & SPECIAL ANIMATIONS
       ========================================================= */
    .hero {
      position: relative;
      min-height: 100vh;
      min-height: 100svh;
      padding: 95px 5vw 120px;
      overflow: hidden;
      display: grid;
      align-items: end;
      background-color: var(--c1);
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      color: #fff;
      transition: background-color .6s ease;
      perspective: 1000px;
    }

    .hero::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, rgba(0, 0, 0, .52), rgba(0, 0, 0, .14));
      pointer-events: none;
      z-index: 1;
    }

    /* Floating Ambient Glowing Orbs behind the model */
    .hero-orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(65px);
      opacity: 0.4;
      pointer-events: none;
      z-index: 1;
      mix-blend-mode: screen;
      transition: background-color 0.8s ease;
    }

    .hero-orb-1 {
      width: 440px;
      height: 440px;
      background: var(--c1);
      top: 12%;
      left: 18%;
      animation: orbFloat1 11s ease-in-out infinite alternate;
    }

    .hero-orb-2 {
      width: 380px;
      height: 380px;
      background: #ffd166;
      bottom: 12%;
      right: 15%;
      animation: orbFloat2 9s ease-in-out infinite alternate;
    }

    @keyframes orbFloat1 {
      0% { transform: translate(0, 0) scale(1); }
      100% { transform: translate(50px, -35px) scale(1.18); }
    }

    @keyframes orbFloat2 {
      0% { transform: translate(0, 0) scale(1); }
      100% { transform: translate(-45px, 30px) scale(1.22); }
    }

    .tag {
      position: absolute;
      top: 85px;
      left: 5vw;
      font-size: 12px;
      color: rgba(255, 255, 255, .9);
      display: flex;
      gap: 10px;
      align-items: center;
      z-index: 2;
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
    }

    .tag i {
      width: 28px;
      height: 1px;
      background: #fff;
    }

    /* Big Watermark Typography with Shimmer and Multi-plane Depth */
    .big {
      position: absolute;
      left: 0;
      right: 0;
      top: 50%;
      margin-top: -0.52em;
      text-align: center;
      font-size: clamp(90px, 19vw, 270px);
      font-weight: 900;
      font-style: italic;
      letter-spacing: -.03em;
      line-height: 1;
      font-stretch: 125%;
      user-select: none;
      z-index: 1;
      background: linear-gradient(135deg, rgba(255,255,255,0.95) 0%, rgba(255,255,255,0.45) 50%, rgba(255,255,255,0.95) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-size: 200% 200%;
      animation: bigShimmer 9s ease-in-out infinite;
      will-change: transform;
      transition: transform 0.25s ease-out;
    }

    @keyframes bigShimmer {
      0% { background-position: 0% 50%; opacity: 0.85; }
      50% { background-position: 100% 50%; opacity: 0.98; }
      100% { background-position: 0% 50%; opacity: 0.85; }
    }

    .hero .tag,
    .hero .copy p,
    .hero .perks,
    .hero .side {
      color: rgba(255, 255, 255, .88);
    }

    .hero .btn {
      background: #fff;
      color: #14201f;
      position: relative;
      overflow: hidden;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.2);
    }

    .hero .btn::after {
      content: "";
      position: absolute;
      top: -50%;
      left: -60%;
      width: 40%;
      height: 200%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.7), transparent);
      transform: rotate(25deg);
      animation: btnShine 4s infinite;
    }

    @keyframes btnShine {
      0%, 75% { left: -60%; }
      100% { left: 140%; }
    }

    .hero .side a.on {
      color: #fff;
      border-bottom-color: #fff;
    }

    .hero .thumb.on {
      border-color: #fff;
    }

    .hero .arrows button {
      background: rgba(255, 255, 255, .18);
      border-color: rgba(255, 255, 255, .45);
      color: #fff;
    }

    .hero .model.noimg {
      border-color: rgba(255, 255, 255, .7);
      color: #fff;
      background: rgba(255, 255, 255, .12);
    }

    /* 3D Tilt & Floating Breathe on Model */
    .model {
      position: absolute;
      left: 50%;
      bottom: 0;
      transform: translateX(-50%);
      width: min(34vw, 300px);
      height: 76%;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      text-align: center;
      color: var(--mute);
      font-size: 13px;
      z-index: 3;
      will-change: transform;
      transition: transform 0.15s ease-out;
    }

    .model img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: bottom;
      display: block;
      filter: drop-shadow(0 16px 32px rgba(0, 0, 0, 0.38));
      animation: modelFloat 5.5s ease-in-out infinite;
      transform-origin: bottom center;
      will-change: transform;
    }

    @keyframes modelFloat {
      0%, 100% {
        transform: translateY(0px) scale(1);
      }
      50% {
        transform: translateY(-9px) scale(1.018);
      }
    }

    .model .ph-text {
      display: none;
    }

    .model.noimg {
      border: 2px dashed var(--mute);
      border-radius: 140px 140px 8px 8px;
      align-items: center;
      background: color-mix(in srgb, var(--bg) 70%, transparent);
    }

    .model.noimg img {
      display: none;
    }

    .model.noimg .ph-text {
      display: block;
    }

    .copy {
      position: relative;
      z-index: 4;
      max-width: 340px;
      will-change: transform;
      transition: transform 0.25s ease-out;
    }

    .copy h1 {
      font-size: clamp(30px, 4vw, 46px);
      font-weight: 800;
      line-height: 1.02;
      letter-spacing: .01em;
      text-transform: uppercase;
      margin-bottom: 16px;
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
    }

    .copy p {
      font-size: 13px;
      color: rgba(255, 255, 255, .88);
      margin-bottom: 22px;
      max-width: 260px;
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
    }

    /* Staggered slide reveal animation classes */
    .slide-enter-text {
      animation: heroTextReveal 0.65s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .slide-enter-model {
      animation: heroModelEntrance 0.75s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    @keyframes heroTextReveal {
      0% {
        opacity: 0;
        transform: translateY(18px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes heroModelEntrance {
      0% {
        opacity: 0.35;
        transform: scale(0.94) translateY(16px);
      }
      100% {
        opacity: 1;
        transform: scale(1) translateY(0);
      }
    }

    .btn {
      display: inline-flex;
      gap: 8px;
      align-items: center;
      justify-content: center;
      background: var(--ink);
      color: var(--bg);
      border-radius: 30px;
      padding: 12px 22px;
      font-size: 12px;
      font-weight: 700;
      transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    }

    .btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
    }

    .perks {
      display: flex;
      gap: 24px;
      margin-top: 40px;
      font-size: 11px;
      color: rgba(255, 255, 255, .88);
    }

    .side {
      position: absolute;
      right: 5vw;
      top: 36px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      text-align: right;
      font-size: 11px;
      color: var(--mute);
    }

    .side a.on {
      color: var(--acc);
      border-bottom: 1px solid var(--acc);
    }

    .thumbs {
      position: absolute;
      right: 5vw;
      bottom: 100px;
      width: 130px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      z-index: 4;
    }

    .thumb {
      height: 78px;
      border-radius: 12px;
      border: 2px solid transparent;
      display: grid;
      place-items: center;
      font-size: 11px;
      font-weight: 700;
      color: #fff;
      transition: .2s;
      background-size: cover;
      background-position: center;
      text-shadow: 0 1px 4px rgba(0, 0, 0, .7);
      cursor: pointer;
    }

    .thumb.on {
      border-color: #fff;
      transform: scale(1.05);
    }

    .arrows {
      display: flex;
      gap: 10px;
      justify-content: center;
    }

    .arrows button {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: rgba(255, 255, 255, .18);
      border: 1px solid rgba(255, 255, 255, .45);
      color: #fff;
      display: grid;
      place-items: center;
      cursor: pointer;
      transition: background 0.2s;
    }

    .arrows button:hover {
      background: rgba(255, 255, 255, .35);
    }

    .contact {
      position: fixed;
      right: 0;
      top: 90px;
      writing-mode: vertical-rl;
      background: var(--ink);
      color: var(--bg);
      padding: 16px 8px;
      border-radius: 12px 0 0 12px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .1em;
      z-index: 20;
    }

    /* =========================================================
       SECTIONS & PRODUCT CARDS
       ========================================================= */
    section {
      padding: 80px 5vw;
    }

    .sh {
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 20px;
      margin-bottom: 34px;
      flex-wrap: wrap;
    }

    .sh h2 {
      font-size: clamp(30px, 5vw, 56px);
      font-weight: 900;
      text-transform: uppercase;
      line-height: .95;
    }

    .sh p {
      font-size: 13px;
      color: var(--mute);
      max-width: 260px;
      text-align: right;
    }

    .cats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
    }

    .cat {
      height: 240px;
      border-radius: 18px;
      padding: 20px;
      display: flex;
      align-items: end;
      font-weight: 800;
      font-size: 20px;
      color: #fff;
      transition: transform .25s ease, box-shadow .25s ease;
      cursor: pointer;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    }

    .cat:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.16);
    }

    /* =========================================================
       CENTER OF PAGE: LUXURY FASHION STATEMENT SECTION
       ========================================================= */
    .fashion-center-statement {
      position: relative;
      padding: 96px 5vw;
      text-align: center;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: radial-gradient(circle at 50% 50%, rgba(242, 106, 27, 0.05) 0%, rgba(15, 127, 116, 0.03) 45%, transparent 75%);
    }

    .fashion-center-glow {
      position: absolute;
      top: 50%;
      left: 50%;
      width: clamp(300px, 60vw, 650px);
      height: clamp(180px, 35vw, 320px);
      transform: translate(-50%, -50%);
      background: radial-gradient(ellipse, rgba(242, 106, 27, 0.16) 0%, rgba(255, 209, 102, 0.1) 40%, transparent 70%);
      filter: blur(55px);
      pointer-events: none;
      z-index: 0;
    }

    .fashion-center-inner {
      position: relative;
      z-index: 1;
      max-width: 900px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .fashion-kicker {
      font-size: 13px;
      font-weight: 700;
      letter-spacing: .24em;
      text-transform: uppercase;
      color: var(--acc);
      margin-bottom: 14px;
      display: inline-block;
      padding: 6px 20px;
      border-radius: 999px;
      background: rgba(242, 106, 27, 0.08);
      border: 1px solid rgba(242, 106, 27, 0.22);
    }

    .fashion-mega-title {
      font-size: clamp(64px, 14vw, 180px);
      font-weight: 900;
      font-style: italic;
      letter-spacing: .06em;
      line-height: 0.95;
      text-transform: uppercase;
      margin: 6px 0 18px;
      color: var(--ink);
      position: relative;
      user-select: none;
      background: linear-gradient(135deg, var(--ink) 0%, var(--acc) 50%, var(--teal) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-size: 200% auto;
      animation: fashionTextGradient 8s ease infinite alternate;
      text-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
    }

    @keyframes fashionTextGradient {
      0% { background-position: 0% 50%; }
      100% { background-position: 100% 50%; }
    }

    .fashion-divider-ornament {
      display: flex;
      align-items: center;
      gap: 14px;
      width: 100%;
      max-width: 320px;
      margin: 8px 0 22px;
    }

    .fashion-divider-ornament span {
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--line), transparent);
    }

    .fashion-divider-ornament i {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--acc);
      box-shadow: 0 0 10px var(--acc);
    }

    .fashion-tagline {
      font-size: clamp(15px, 2vw, 19px);
      color: var(--mute);
      line-height: 1.6;
      max-width: 680px;
      margin: 0 auto;
      font-weight: 400;
    }

    .chips {
      display: flex;
      gap: 8px;
      margin-bottom: 24px;
      flex-wrap: wrap;
    }

    .chip {
      padding: 8px 16px;
      border-radius: 20px;
      border: 1px solid var(--line);
      font-size: 12px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .chip.on {
      background: var(--ink);
      color: var(--bg);
      border-color: var(--ink);
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 22px;
    }

    /* Product Card with Favourite Heart and Add Button */
    .card {
      position: relative;
      display: flex;
      flex-direction: column;
      border-radius: 16px;
      transition: transform 0.25s ease;
    }

    .card:hover {
      transform: translateY(-3px);
    }

    .card .ph {
      position: relative;
      height: 260px;
      border-radius: 16px;
      background: var(--card);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 12px;
      color: var(--mute);
      font-size: 13px;
      margin-bottom: 12px;
      overflow: hidden;
      border: 1px solid var(--line);
      transition: border-color 0.2s ease;
    }

    .card:hover .ph {
      border-color: rgba(0, 0, 0, 0.15);
    }

    .card-icon {
      font-size: 48px;
      opacity: 0.9;
      transition: transform 0.3s ease;
    }

    .card:hover .card-icon {
      transform: scale(1.1);
    }

    .card-category-tag {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      padding: 4px 10px;
      border-radius: 20px;
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(4px);
    }

    /* Heart / Wishlist Toggle Button on Card */
    .fav-btn {
      position: absolute;
      top: 12px;
      right: 12px;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(6px);
      color: var(--mute);
      display: grid;
      place-items: center;
      font-size: 18px;
      box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
      cursor: pointer;
      transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), color 0.2s ease, background 0.2s ease;
      z-index: 5;
    }

    .fav-btn:hover {
      transform: scale(1.15);
      color: #e11d48;
    }

    .fav-btn.active {
      color: #e11d48;
      background: #fff;
    }

    .fav-btn.active.pop {
      animation: heartPop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @keyframes heartPop {
      0% { transform: scale(1); }
      40% { transform: scale(1.4); }
      100% { transform: scale(1); }
    }

    .card h3 {
      font-size: 15px;
      font-weight: 700;
      margin-bottom: 2px;
    }

    .card span {
      font-size: 13px;
      color: var(--mute);
      margin-bottom: 8px;
    }

    /* Add to Cart button */
    .card .add {
      margin-top: auto;
      width: 100%;
      padding: 10px;
      border-radius: 24px;
      border: 1px solid var(--ink);
      font-size: 12px;
      font-weight: 700;
      transition: all 0.25s ease;
      background: transparent;
      color: var(--ink);
    }

    .card .add:hover {
      background: var(--ink);
      color: var(--bg);
    }

    .card .add.added {
      background: var(--teal) !important;
      border-color: var(--teal) !important;
      color: #fff !important;
      transform: scale(0.97);
    }

    /* =========================================================
       CART ANIMATIONS (Flyer, Bounce, Badge Pulse)
       ========================================================= */
    .cart-flyer {
      position: fixed;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: var(--acc);
      color: #fff;
      display: grid;
      place-items: center;
      font-size: 15px;
      z-index: 99999;
      pointer-events: none;
      box-shadow: 0 4px 16px rgba(242, 106, 27, 0.5);
      transition: transform 0.65s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.65s ease;
    }

    @keyframes cartBump {
      0% { transform: scale(1); }
      25% { transform: scale(1.35) rotate(-12deg); }
      50% { transform: scale(1.2) rotate(8deg); }
      75% { transform: scale(1.08) rotate(-4deg); }
      100% { transform: scale(1) rotate(0); }
    }

    .cart-bump {
      animation: cartBump 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .cart-bump #count {
      animation: badgePulse 0.55s ease;
    }

    @keyframes badgePulse {
      0% { transform: scale(1); }
      40% { transform: scale(1.65); background: #22c55e; }
      100% { transform: scale(1); }
    }

    /* =========================================================
       DRAWER & MODAL OVERLAYS
       ========================================================= */
    .drawer-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.45);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      z-index: 2000;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    .drawer-overlay.open {
      opacity: 1;
      pointer-events: auto;
    }

    .drawer {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      width: min(420px, 92vw);
      background: var(--bg);
      color: var(--ink);
      z-index: 2001;
      box-shadow: -6px 0 28px rgba(0, 0, 0, 0.18);
      display: flex;
      flex-direction: column;
      transform: translateX(100%);
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .drawer.open {
      transform: translateX(0);
    }

    .drawer-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 20px 24px;
      border-bottom: 1px solid var(--line);
    }

    .drawer-title {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .drawer-title h3 {
      font-size: 18px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .pill-badge {
      font-size: 11px;
      font-weight: 700;
      padding: 3px 9px;
      border-radius: 12px;
      background: var(--card);
      color: var(--mute);
    }

    .vip-badge {
      background: #fef3c7;
      color: #92400e;
      border: 1px solid rgba(245, 158, 11, 0.3);
    }

    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) .vip-badge {
        background: #78350f;
        color: #fef3c7;
      }
    }

    .drawer-close {
      font-size: 24px;
      width: 34px;
      height: 34px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      color: var(--mute);
      transition: background 0.2s, color 0.2s;
    }

    .drawer-close:hover {
      background: var(--card);
      color: var(--ink);
    }

    .drawer-body {
      flex: 1;
      overflow-y: auto;
      padding: 20px 24px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    /* Cart / Favourites Items */
    .drawer-item {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 12px;
      background: var(--card);
      border-radius: 14px;
      border: 1px solid var(--line);
      animation: fadeInItem 0.25s ease;
    }

    @keyframes fadeInItem {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .item-thumb {
      width: 60px;
      height: 60px;
      border-radius: 10px;
      background: var(--bg);
      display: grid;
      place-items: center;
      font-size: 26px;
      flex-shrink: 0;
      border: 1px solid var(--line);
    }

    .item-info {
      flex: 1;
      min-width: 0;
    }

    .item-info h4 {
      font-size: 14px;
      font-weight: 700;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      margin-bottom: 2px;
    }

    .item-info p {
      font-size: 12px;
      color: var(--mute);
      margin-bottom: 6px;
    }

    .item-price {
      font-size: 13px;
      font-weight: 800;
      color: var(--acc);
    }

    .qty-controls {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--bg);
      padding: 3px 8px;
      border-radius: 20px;
      border: 1px solid var(--line);
      font-size: 12px;
      margin-top: 4px;
    }

    .qty-btn {
      width: 20px;
      height: 20px;
      display: grid;
      place-items: center;
      font-weight: 800;
      cursor: pointer;
      color: var(--ink);
    }

    .qty-btn:hover {
      color: var(--acc);
    }

    .qty-num {
      font-weight: 700;
      min-width: 14px;
      text-align: center;
    }

    .item-remove {
      font-size: 18px;
      color: var(--mute);
      padding: 6px;
      cursor: pointer;
      transition: color 0.2s;
    }

    .item-remove:hover {
      color: #e11d48;
    }

    .empty-drawer {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: var(--mute);
      padding: 40px 20px;
    }

    .empty-drawer-icon {
      font-size: 52px;
      margin-bottom: 14px;
      opacity: 0.8;
    }

    .empty-drawer h4 {
      font-size: 18px;
      font-weight: 800;
      color: var(--ink);
      margin-bottom: 6px;
    }

    .empty-drawer p {
      font-size: 13px;
      max-width: 220px;
      margin-bottom: 20px;
    }

    .drawer-footer {
      padding: 20px 24px;
      border-top: 1px solid var(--line);
      background: var(--bg);
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .summary-row {
      display: flex;
      justify-content: space-between;
      font-size: 15px;
    }

    .summary-row strong {
      font-size: 18px;
      color: var(--acc);
    }

    .free-shipping-bar {
      font-size: 11px;
      color: var(--mute);
      display: flex;
      align-items: center;
      gap: 6px;
      background: var(--card);
      padding: 8px 12px;
      border-radius: 8px;
    }

    .btn-block {
      width: 100%;
      text-align: center;
      padding: 13px;
    }

    .btn-outline {
      width: 100%;
      text-align: center;
      padding: 10px;
      border: 1px solid var(--line);
      border-radius: 30px;
      font-size: 12px;
      font-weight: 700;
      color: var(--mute);
      transition: all 0.2s;
    }

    .btn-outline:hover {
      border-color: var(--ink);
      color: var(--ink);
    }

    /* =========================================================
       SIGN IN & USER AUTH MODAL (ACTIVE & FUNCTIONABLE)
       ========================================================= */
    .auth-modal {
      position: fixed;
      inset: 0;
      z-index: 3500;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .auth-modal.open {
      display: flex;
    }

    .auth-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }

    .auth-card {
      position: relative;
      width: min(440px, 100%);
      background: var(--bg);
      border-radius: 24px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      padding: 32px 28px;
      border: 1px solid var(--line);
      z-index: 2;
      animation: modalSlideDown 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .auth-close {
      position: absolute;
      top: 18px;
      right: 18px;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      font-size: 20px;
      color: var(--mute);
      transition: background 0.2s, color 0.2s;
    }

    .auth-close:hover {
      background: var(--card);
      color: var(--ink);
    }

    .auth-brand-header {
      text-align: center;
      margin-bottom: 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .auth-brand-header .logo-symbol.lg {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      margin-bottom: 10px;
      background: linear-gradient(135deg, rgba(242, 106, 27, 0.15), rgba(15, 127, 116, 0.15));
      border: 2px solid var(--acc);
      color: var(--acc);
    }

    .auth-brand-header h3 {
      font-size: 22px;
      font-weight: 900;
      letter-spacing: 0.04em;
      margin-bottom: 4px;
    }

    .auth-brand-header p {
      font-size: 13px;
      color: var(--mute);
    }

    /* 1-Click Demo Login Box */
    .demo-login-box {
      margin-bottom: 18px;
    }

    .btn-demo-login {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      border-radius: 14px;
      background: linear-gradient(135deg, #fff3eb 0%, #ffe6d5 100%);
      border: 1.5px dashed var(--acc);
      color: var(--ink);
      cursor: pointer;
      text-align: left;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) .btn-demo-login {
        background: linear-gradient(135deg, #2a1b12 0%, #1f1814 100%);
        border-color: var(--acc);
      }
    }

    .btn-demo-login:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 16px rgba(242, 106, 27, 0.25);
    }

    .demo-bolt {
      font-size: 22px;
      filter: drop-shadow(0 2px 4px rgba(242, 106, 27, 0.4));
    }

    .demo-text {
      flex: 1;
    }

    .demo-text strong {
      display: block;
      font-size: 13px;
      color: var(--acc);
    }

    .demo-text small {
      font-size: 11px;
      color: var(--mute);
    }

    .demo-arrow {
      font-size: 16px;
      color: var(--acc);
      font-weight: 800;
    }

    .auth-divider {
      display: flex;
      align-items: center;
      text-align: center;
      margin: 16px 0;
      color: var(--mute);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .auth-divider::before, .auth-divider::after {
      content: "";
      flex: 1;
      border-bottom: 1px solid var(--line);
    }

    .auth-divider span {
      padding: 0 10px;
    }

    /* Tabs */
    .auth-tabs {
      display: flex;
      background: var(--card);
      padding: 4px;
      border-radius: 30px;
      margin-bottom: 18px;
      border: 1px solid var(--line);
    }

    .auth-tab {
      flex: 1;
      padding: 8px 12px;
      border-radius: 24px;
      font-size: 12px;
      font-weight: 700;
      color: var(--mute);
      transition: all 0.2s ease;
      text-align: center;
    }

    .auth-tab.on {
      background: var(--bg);
      color: var(--ink);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    /* Form inputs */
    .auth-form {
      display: flex;
      flex-direction: column;
      gap: 13px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .form-group label {
      font-size: 12px;
      font-weight: 700;
    }

    .form-label-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .form-link {
      font-size: 11px;
      color: var(--acc);
      font-weight: 600;
    }

    .form-link:hover {
      text-decoration: underline;
    }

    .form-group input {
      padding: 11px 14px;
      border-radius: 12px;
      border: 1px solid var(--line);
      background: var(--card);
      color: var(--ink);
      font-size: 13px;
      outline: none;
      transition: border-color 0.2s;
    }

    .form-group input:focus {
      border-color: var(--acc);
    }

    .input-password-wrap {
      position: relative;
      display: flex;
    }

    .input-password-wrap input {
      flex: 1;
      padding-right: 40px;
    }

    .btn-toggle-pass {
      position: absolute;
      right: 10px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 14px;
      color: var(--mute);
      cursor: pointer;
      padding: 4px;
    }

    .pass-strength-bar {
      height: 4px;
      background: var(--line);
      border-radius: 2px;
      overflow: hidden;
      margin-top: 3px;
    }

    .pass-strength-fill {
      height: 100%;
      width: 0%;
      border-radius: 2px;
      transition: width 0.3s ease, background-color 0.3s ease;
    }

    .form-remember-row {
      display: flex;
      align-items: center;
      font-size: 12px;
      color: var(--mute);
    }

    .checkbox-label {
      display: flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
    }

    .auth-submit-btn {
      margin-top: 6px;
      padding: 12px;
    }

    .auth-footer-note {
      text-align: center;
      margin-top: 16px;
      font-size: 11px;
      color: var(--mute);
    }

    /* Confetti Particle on Sign In */
    .auth-confetti {
      position: fixed;
      width: 8px;
      height: 8px;
      border-radius: 2px;
      z-index: 99999;
      pointer-events: none;
      animation: confettiFall 1.2s cubic-bezier(0.25, 1, 0.5, 1) forwards;
    }

    @keyframes confettiFall {
      0% { transform: translateY(0) rotate(0deg) scale(1); opacity: 1; }
      100% { transform: translateY(220px) rotate(720deg) scale(0.3); opacity: 0; }
    }

    /* User Profile Dashboard (When Logged In) */
    .profile-card {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 16px;
      background: var(--card);
      border-radius: 18px;
      border: 1px solid var(--line);
    }

    .profile-avatar {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--acc), #d94a5b);
      color: #fff;
      font-size: 20px;
      font-weight: 800;
      display: grid;
      place-items: center;
      box-shadow: 0 4px 14px rgba(242, 106, 27, 0.35);
      flex-shrink: 0;
    }

    .profile-info h4 {
      font-size: 16px;
      font-weight: 800;
      margin-bottom: 2px;
    }

    .profile-info p {
      font-size: 12px;
      color: var(--mute);
      margin-bottom: 6px;
    }

    .vip-member-tag {
      display: inline-block;
      font-size: 10px;
      font-weight: 800;
      padding: 3px 8px;
      border-radius: 20px;
      background: #fef3c7;
      color: #92400e;
      letter-spacing: 0.04em;
    }

    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) .vip-member-tag {
        background: #78350f;
        color: #fef3c7;
      }
    }

    .rewards-card {
      padding: 16px;
      background: linear-gradient(135deg, rgba(242, 106, 27, 0.08), rgba(15, 127, 116, 0.08));
      border: 1px solid rgba(242, 106, 27, 0.2);
      border-radius: 16px;
    }

    .rewards-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
      margin-bottom: 4px;
    }

    .rewards-header strong {
      font-size: 18px;
      color: var(--acc);
    }

    .rewards-val {
      font-size: 12px;
      color: var(--mute);
      margin-bottom: 8px;
    }

    .points-progress-bar {
      height: 6px;
      border-radius: 4px;
      background: var(--line);
      overflow: hidden;
      margin-bottom: 6px;
    }

    .points-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--acc), #0f7f74);
      border-radius: 4px;
    }

    .rewards-card small {
      font-size: 11px;
      color: var(--mute);
    }

    .benefits-box {
      background: var(--card);
      padding: 16px;
      border-radius: 14px;
      border: 1px solid var(--line);
    }

    .benefits-box h5 {
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 10px;
    }

    .benefits-list {
      list-style: none;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
      font-size: 12px;
      color: var(--mute);
    }

    .benefits-list li {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .recent-order-box {
      background: var(--card);
      padding: 16px;
      border-radius: 14px;
      border: 1px solid var(--line);
    }

    .recent-order-box h5 {
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 10px;
    }

    .recent-order-item {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .order-ico {
      font-size: 24px;
    }

    .order-desc {
      flex: 1;
    }

    .order-desc strong {
      display: block;
      font-size: 12px;
    }

    .order-desc span {
      font-size: 11px;
      color: var(--mute);
    }

    .order-status-tag {
      font-size: 11px;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 12px;
      background: #dcfce7;
      color: #166534;
    }

    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) .order-status-tag {
        background: #14532d;
        color: #dcfce7;
      }
    }

    .btn-logout {
      color: #e11d48 !important;
      border-color: rgba(225, 29, 72, 0.3) !important;
    }

    .btn-logout:hover {
      background: #ffe4e6 !important;
      border-color: #e11d48 !important;
    }

    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) .btn-logout:hover {
        background: #4c0519 !important;
      }
    }

    /* =========================================================
       SEARCH MODAL (Active Search Section)
       ========================================================= */
    .search-modal {
      position: fixed;
      inset: 0;
      z-index: 3000;
      display: none;
      align-items: flex-start;
      justify-content: center;
      padding: 80px 20px 40px;
    }

    .search-modal.open {
      display: flex;
    }

    .search-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.55);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }

    .search-card {
      position: relative;
      width: min(620px, 100%);
      background: var(--bg);
      border-radius: 22px;
      box-shadow: 0 16px 48px rgba(0, 0, 0, 0.25);
      overflow: hidden;
      border: 1px solid var(--line);
      animation: modalSlideDown 0.28s cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 2;
    }

    @keyframes modalSlideDown {
      from { transform: translateY(-24px) scale(0.96); opacity: 0; }
      to { transform: translateY(0) scale(1); opacity: 1; }
    }

    .search-input-box {
      display: flex;
      align-items: center;
      padding: 16px 20px;
      gap: 12px;
      border-bottom: 1px solid var(--line);
    }

    .search-input-box span.search-icon {
      font-size: 20px;
      color: var(--mute);
    }

    .search-input-box input {
      flex: 1;
      border: 0;
      background: transparent;
      color: var(--ink);
      font-size: 16px;
      font-weight: 600;
      outline: none;
    }

    .search-clear-btn, .search-esc-btn {
      font-size: 12px;
      padding: 4px 8px;
      border-radius: 6px;
      background: var(--card);
      color: var(--mute);
      cursor: pointer;
    }

    .search-quick-tags {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 12px 20px;
      background: var(--card);
      font-size: 11px;
      flex-wrap: wrap;
      border-bottom: 1px solid var(--line);
    }

    .search-tag-chip {
      padding: 4px 12px;
      border-radius: 14px;
      background: var(--bg);
      border: 1px solid var(--line);
      cursor: pointer;
      font-weight: 600;
      color: var(--ink);
      transition: all 0.2s;
    }

    .search-tag-chip:hover {
      background: var(--acc);
      color: #fff;
      border-color: var(--acc);
    }

    .search-results-list {
      max-height: 380px;
      overflow-y: auto;
      padding: 14px 20px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .search-result-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 14px;
      border-radius: 12px;
      background: var(--card);
      transition: background 0.2s;
      gap: 14px;
    }

    .search-result-row:hover {
      background: color-mix(in srgb, var(--card) 60%, var(--line));
    }

    .search-res-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .search-res-icon {
      width: 40px;
      height: 40px;
      border-radius: 8px;
      background: var(--bg);
      display: grid;
      place-items: center;
      font-size: 20px;
      border: 1px solid var(--line);
    }

    .search-res-info h5 {
      font-size: 14px;
      font-weight: 700;
    }

    .search-res-info p {
      font-size: 12px;
      color: var(--mute);
    }

    .search-res-right {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .search-res-price {
      font-size: 14px;
      font-weight: 800;
      color: var(--acc);
    }

    .search-res-btn {
      padding: 6px 14px;
      border-radius: 20px;
      background: var(--ink);
      color: var(--bg);
      font-size: 11px;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.2s;
    }

    .search-res-btn:hover {
      background: var(--acc);
    }

    /* =========================================================
       MOBILE MENU DRAWER
       ========================================================= */
    .mobile-drawer {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: min(320px, 85vw);
      background: var(--bg);
      color: var(--ink);
      z-index: 2001;
      box-shadow: 6px 0 28px rgba(0, 0, 0, 0.18);
      display: flex;
      flex-direction: column;
      transform: translateX(-100%);
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .mobile-drawer.open {
      transform: translateX(0);
    }

    .mobile-nav-links {
      display: flex;
      flex-direction: column;
      padding: 16px 20px;
      gap: 4px;
    }

    .mobile-nav-links a {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 14px;
      font-size: 15px;
      font-weight: 700;
      border-radius: 10px;
      transition: background 0.2s, color 0.2s;
      color: var(--ink);
    }

    .mobile-nav-links a:hover,
    .mobile-nav-links a.on {
      background: var(--card);
      color: var(--acc);
    }

    .mobile-quick-actions {
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding: 16px 20px;
      margin-top: auto;
      border-top: 1px solid var(--line);
    }

    .mobile-action-btn {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
      border-radius: 12px;
      background: var(--card);
      font-size: 13px;
      font-weight: 700;
      color: var(--ink);
      cursor: pointer;
    }

    .mobile-action-btn:hover {
      background: var(--line);
    }

    /* =========================================================
       NEWSLETTER & FOOTER
       ========================================================= */
    .news {
      background: var(--card);
      border-radius: 24px;
      margin: 0 5vw 60px;
      padding: 50px;
      display: flex;
      justify-content: space-between;
      gap: 24px;
      flex-wrap: wrap;
      align-items: center;
    }

    .news h2 {
      font-size: 30px;
      font-weight: 900;
      text-transform: uppercase;
    }

    .news div {
      display: flex;
      gap: 8px;
    }

    .news input {
      padding: 12px 18px;
      border-radius: 30px;
      border: 1px solid var(--line);
      background: var(--bg);
      color: var(--ink);
      min-width: 220px;
    }

    footer {
      padding: 30px 5vw;
      border-top: 1px solid var(--line);
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      color: var(--mute);
      flex-wrap: wrap;
      gap: 10px;
    }

    .toast {
      position: fixed;
      left: 50%;
      bottom: 24px;
      transform: translate(-50%, 80px);
      background: var(--ink);
      color: var(--bg);
      padding: 12px 24px;
      border-radius: 30px;
      font-size: 13px;
      font-weight: 600;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 4000;
      pointer-events: none;
    }

    .toast.show {
      transform: translate(-50%, 0);
    }

    /* =========================================================
       RESPONSIVE MEDIA QUERIES
       ========================================================= */
    @media(max-width:820px) {
      header nav {
        display: none;
      }

      #menuBtn {
        display: flex;
      }

      .side {
        display: none;
      }

      .model {
        width: 50vw;
        height: 58%;
      }

      .thumbs {
        flex-direction: row;
        width: auto;
        bottom: 16px;
      }

      .thumb {
        width: 64px;
        height: 64px;
      }

      .arrows {
        display: none;
      }

      .hero {
        padding-top: 90px;
        padding-bottom: 150px;
        min-height: 100vh;
        min-height: 100svh;
      }

      .perks {
        flex-wrap: wrap;
        gap: 12px;
      }

      .copy {
        margin-bottom: 60px;
        max-width: 220px;
      }

      .sh p {
        text-align: left;
      }
    }

    @media(prefers-reduced-motion:reduce) {
      * {
        transition: none !important;
        scroll-behavior: auto !important;
        animation: none !important;
      }
    }
  </style>
</head>

<body>
  <!-- TOP-TO-BOTTOM SCROLL PROGRESS BAR -->
  <div id="scrollProgressBar" class="scroll-progress-bar"></div>

  <!-- INTERACTIVE MOUSE GLOW FOLLOWER (Smoothly tracks mouse across page) -->
  <div id="mouseGlowFollower" class="mouse-glow-follower"></div>

  <!-- HEADER & TRANSPARENT NAVBAR (DISTINCT NOSTRA+ LOGO & NO BOTTOM LINE) -->
  <header id="mainHeader">
    <a class="logo" href="#top" title="NOSTRA+ NEW WORLD">
      <span class="logo-text">
        NOSTRA +
        <small>NEW WORLD</small>
      </span>
    </a>
    <nav id="nav">
      <a href="#shop" class="on">Shop</a>
      <a href="#shop" data-f="Women">Women</a>
      <a href="#shop" data-f="Men">Men</a>
      <a href="#shop" data-f="Sunglass">Sunglass</a>
      <a href="#cats">Collections</a>
      <a href="#about">About</a>
    </nav>
    <div class="icons">
      <button aria-label="Search" id="searchBtn" title="Search products">&#9906;</button>
      <button aria-label="Favourites" id="favBtn" title="Your Favourites">&#9825;<b id="favCount">0</b></button>
      <button aria-label="Account" id="userBtn" title="Sign In / Account">&#9786;</button>
      <button aria-label="Cart" id="cartBtn" title="Your Cart">&#128717;<b id="count">0</b></button>
      <button aria-label="Menu" id="menuBtn" title="Toggle menu">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </header>

  <!-- AUTH MODAL (SIGN IN / CREATE ACCOUNT) -->
  <div class="auth-modal" id="authModal" aria-hidden="true">
    <div class="auth-backdrop" id="authBackdrop"></div>
    <div class="auth-card">
      <button class="auth-close" id="closeAuthModal" aria-label="Close dialog">&times;</button>
      
      <!-- Distinct Brand Emblem in Sign-In Section -->
      <div class="auth-brand-header">
        <div class="logo-symbol lg">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none">
            <rect x="2" y="2" width="20" height="20" rx="6" stroke="currentColor" stroke-width="2"/>
            <path d="M7 17V7L17 17V7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="18" cy="6" r="2.5" fill="var(--acc)"/>
          </svg>
        </div>
        <h3>NOSTRA<span style="color:var(--acc)">+</span></h3>
        <p id="authSubtitle">Join the future of performance luxury</p>
      </div>

      <!-- Quick 1-Click Demo Login -->
      <div class="demo-login-box">
        <button class="btn-demo-login" id="demoLoginBtn" type="button">
          <span class="demo-bolt"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none" style="display:inline-block;vertical-align:middle;color:#f26a1b"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></span>
          <div class="demo-text">
            <strong>1-Click Instant Demo Login</strong>
            <small>Continue as Alex Rivera (VIP Gold Member)</small>
          </div>
          <span class="demo-arrow">&rarr;</span>
        </button>
      </div>

      <div class="auth-divider"><span>or with credentials</span></div>

      <!-- Tabs: Sign In / Create Account -->
      <div class="auth-tabs">
        <button class="auth-tab on" id="tabSignIn" type="button">Sign In</button>
        <button class="auth-tab" id="tabSignUp" type="button">Create Account</button>
      </div>

      <!-- Sign In Form -->
      <form class="auth-form" id="signInForm" onsubmit="return false;">
        <div class="form-group">
          <label for="loginEmail">Email Address</label>
          <input type="email" id="loginEmail" placeholder="you@example.com" value="alex@nostra.fashion" required autocomplete="email">
        </div>
        <div class="form-group">
          <div class="form-label-row">
            <label for="loginPass">Password</label>
            <a href="#" id="forgotPassLink" class="form-link">Forgot password?</a>
          </div>
          <div class="input-password-wrap">
            <input type="password" id="loginPass" placeholder="••••••••" value="nostra2026" required autocomplete="current-password">
            <button type="button" class="btn-toggle-pass" id="toggleLoginPass" aria-label="Toggle password visibility"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>️</button>
          </div>
        </div>
        <div class="form-remember-row">
          <label class="checkbox-label">
            <input type="checkbox" id="rememberMe" checked>
            <span>Remember me</span>
          </label>
        </div>
        <button type="submit" class="btn btn-block auth-submit-btn" id="submitSignIn">
          Sign In to NOSTRA+ &rarr;
        </button>
      </form>

      <!-- Sign Up Form (Toggled via tabs) -->
      <form class="auth-form" id="signUpForm" style="display:none;" onsubmit="return false;">
        <div class="form-group">
          <label for="registerName">Full Name</label>
          <input type="text" id="registerName" placeholder="Elena Rostova" required autocomplete="name">
        </div>
        <div class="form-group">
          <label for="registerEmail">Email Address</label>
          <input type="email" id="registerEmail" placeholder="elena@nostra.com" required autocomplete="email">
        </div>
        <div class="form-group">
          <label for="registerPass">Password</label>
          <div class="input-password-wrap">
            <input type="password" id="registerPass" placeholder="Create strong password" required autocomplete="new-password">
            <button type="button" class="btn-toggle-pass" id="toggleRegisterPass" aria-label="Toggle password visibility"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>️</button>
          </div>
          <div class="pass-strength-bar"><div class="pass-strength-fill" id="passStrength"></div></div>
        </div>
        <button type="submit" class="btn btn-block auth-submit-btn" id="submitSignUp">
          Create NOSTRA+ Account &rarr;
        </button>
      </form>

      <div class="auth-footer-note">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg> 256-bit encrypted authentication &middot; VIP Gold Rewards
      </div>
    </div>
  </div>

  <!-- USER PROFILE DASHBOARD DRAWER (ACTIVE WHEN LOGGED IN) -->
  <div class="drawer-overlay" id="profileOverlay"></div>
  <aside class="drawer" id="profileDrawer" aria-label="Member Profile">
    <div class="drawer-header">
      <div class="drawer-title">
        <h3>Member Profile</h3>
        <span class="pill-badge vip-badge" id="profileTierBadge">VIP Gold</span>
      </div>
      <button class="drawer-close" id="closeProfile" aria-label="Close profile">&times;</button>
    </div>
    <div class="drawer-body">
      <!-- Profile Header -->
      <div class="profile-card">
        <div class="profile-avatar" id="profileAvatar">AR</div>
        <div class="profile-info">
          <h4 id="profileName">Alex Rivera</h4>
          <p id="profileEmail">alex@nostra.fashion</p>
          <span class="vip-member-tag"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none" style="display:inline-block;vertical-align:middle;color:#f26a1b"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg> VIP Club Member</span>
        </div>
      </div>

      <!-- Loyalty Rewards Card -->
      <div class="rewards-card">
        <div class="rewards-header">
          <span>NOSTRA+ Rewards</span>
          <strong id="profilePoints">640 pts</strong>
        </div>
        <div class="rewards-val">Redeemable for <strong>$32.00 Store Credit</strong></div>
        <div class="points-progress-bar"><div class="points-fill" style="width: 68%;"></div></div>
        <small>360 points until Diamond VIP Status</small>
      </div>

      <!-- Active VIP Benefits -->
      <div class="benefits-box">
        <h5>Active Member Privileges</h5>
        <ul class="benefits-list">
          <li><span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle"><rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg></span> Free Express 2-Day Shipping</li>
          <li><span><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none" style="display:inline-block;vertical-align:middle;color:#f26a1b"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/></svg></span> VIP Early Access to New Collections</li>
          <li><span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle"><rect x="3" y="8" width="18" height="13" rx="2"/><path d="M12 8v13"/><path d="M19 12H5"/><path d="M12 8a3 3 0 0 1-3-3c0-1.5 1.5-2 3 0 1.5-2 3-1.5 3 0a3 3 0 0 1-3 3Z"/></svg></span> 10% Birthday Reward Voucher</li>
          <li><span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 21h5v-5"/></svg></span> 45-Day Complimentary Returns</li>
        </ul>
      </div>

      <!-- Recent Activity -->
      <div class="recent-order-box">
        <h5>Recent Order</h5>
        <div class="recent-order-item">
          <div class="order-ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg></div>
          <div class="order-desc">
            <strong>Order #NS-89241</strong>
            <span>Court Dress &middot; Track Jacket</span>
          </div>
          <span class="order-status-tag">Shipped</span>
        </div>
      </div>
    </div>
    <div class="drawer-footer">
      <button class="btn btn-block" id="profileShopBtn">Continue Shopping &rarr;</button>
      <button class="btn-outline btn-logout" id="logoutBtn">Sign Out</button>
    </div>
  </aside>

  <!-- CART DRAWER -->
  <div class="drawer-overlay" id="cartOverlay"></div>
  <aside class="drawer" id="cartDrawer" aria-label="Shopping Cart">
    <div class="drawer-header">
      <div class="drawer-title">
        <h3>Shopping Cart</h3>
        <span class="pill-badge" id="cartDrawerCount">0 items</span>
      </div>
      <button class="drawer-close" id="closeCart" aria-label="Close cart">&times;</button>
    </div>
    <div class="drawer-body" id="cartItems">
      <!-- Items dynamically populated -->
    </div>
    <div class="drawer-footer" id="cartFooter">
      <div class="free-shipping-bar">
        <span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle"><rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg></span> Free Express Shipping included on all orders
      </div>
      <div class="summary-row">
        <span>Subtotal</span>
        <strong id="cartSubtotal">$0.00</strong>
      </div>
      <button class="btn btn-block" id="checkoutBtn">Proceed to Checkout &rarr;</button>
      <button class="btn-outline" id="clearCartBtn">Clear Cart</button>
    </div>
  </aside>

  <!-- FAVOURITES DRAWER -->
  <div class="drawer-overlay" id="favOverlay"></div>
  <aside class="drawer" id="favDrawer" aria-label="Favourites Wishlist">
    <div class="drawer-header">
      <div class="drawer-title">
        <h3>Favourites</h3>
        <span class="pill-badge" id="favDrawerCount">0 items</span>
      </div>
      <button class="drawer-close" id="closeFav" aria-label="Close favourites">&times;</button>
    </div>
    <div class="drawer-body" id="favItems">
      <!-- Favourites dynamically populated -->
    </div>
    <div class="drawer-footer">
      <button class="btn btn-block" id="addAllFavToCartBtn">Add All Favourites to Cart</button>
      <button class="btn-outline" id="clearFavBtn">Clear Favourites</button>
    </div>
  </aside>

  <!-- SEARCH MODAL -->
  <div class="search-modal" id="searchModal" aria-hidden="true">
    <div class="search-backdrop" id="searchBackdrop"></div>
    <div class="search-card">
      <div class="search-input-box">
        <span class="search-icon">&#9906;</span>
        <input type="text" id="searchInput" placeholder="Search apparel, dresses, sunglasses, sneakers..." autocomplete="off">
        <button class="search-clear-btn" id="searchClear">Clear</button>
        <button class="search-esc-btn" id="searchClose">ESC</button>
      </div>
      <div class="search-quick-tags">
        <span>Popular:</span>
        <button class="search-tag-chip" data-q="Women">Women</button>
        <button class="search-tag-chip" data-q="Men">Men</button>
        <button class="search-tag-chip" data-q="Sunglass">Sunglass</button>
        <button class="search-tag-chip" data-q="Court">Court</button>
        <button class="search-tag-chip" data-q="Jacket">Jacket</button>
        <button class="search-tag-chip" data-q="Sneakers">Sneakers</button>
      </div>
      <div class="search-results-list" id="searchResults">
        <!-- Live search results -->
      </div>
    </div>
  </div>

  <!-- MOBILE MENU DRAWER -->
  <div class="drawer-overlay" id="mobileOverlay"></div>
  <aside class="mobile-drawer" id="mobileDrawer" aria-label="Mobile Navigation">
    <div class="drawer-header">
      <div class="drawer-title">
        <div class="logo" style="color:var(--ink);text-shadow:none">
          <span class="logo-symbol" style="background:var(--card);border-color:var(--line);color:var(--ink)">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <rect x="2" y="2" width="20" height="20" rx="6" stroke="currentColor" stroke-width="2"/>
              <path d="M7 17V7L17 17V7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="18" cy="6" r="2.5" fill="var(--acc)"/>
            </svg>
          </span>
          <span class="logo-text">
            NOSTRA<span class="logo-plus">+</span>
            <small>NEW WORLD</small>
          </span>
        </div>
      </div>
      <button class="drawer-close" id="closeMobileMenu" aria-label="Close menu">&times;</button>
    </div>
    <div class="mobile-nav-links">
      <a href="#shop" class="mobile-nav-link on" data-f="All"><span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></span> Shop All</a>
      <a href="#shop" class="mobile-nav-link" data-f="Women"><span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle"><path d="M9 3l3 2 3-2 3 7-2 11H8L6 10z"/><path d="M10 5a2 2 0 0 0 4 0"/></svg></span> Women</a>
      <a href="#shop" class="mobile-nav-link" data-f="Men"><span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle"><path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg></span> Men</a>
      <a href="#shop" class="mobile-nav-link" data-f="Sunglass"><span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle"><circle cx="6" cy="14" r="4"/><circle cx="18" cy="14" r="4"/><path d="M10 14h4"/><path d="M3.5 10.5 5 14"/><path d="M20.5 10.5 19 14"/></svg></span> Sunglass</a>
      <a href="#shop" class="mobile-nav-link" data-f="Footwear"><span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle"><path d="M2 17h20v3H2z"/><path d="M4 17V8l4-2h5l3 5 4 1v5"/></svg></span> Footwear</a>
      <a href="#cats" class="mobile-nav-link"><span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg></span> Collections</a>
      <a href="#about" class="mobile-nav-link"><span>ℹ️</span> About Us</a>
    </div>
    <div class="mobile-quick-actions">
      <button class="mobile-action-btn" id="mAccountBtn">
        <span id="mAccountLabel"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg> Sign In / Join VIP</span>
        <span class="pill-badge" id="mAccountBadge">VIP</span>
      </button>
      <button class="mobile-action-btn" id="mCartBtn">
        <span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle"><path d="M2 3h2.5l2.4 12.2a1.5 1.5 0 0 0 1.5 1.2h8.9a1.5 1.5 0 0 0 1.5-1.1L20.5 8H5.6"/><circle cx="9.5" cy="20" r="1.3"/><circle cx="17" cy="20" r="1.3"/></svg> View Cart</span>
        <span class="pill-badge" id="mCartBadge">0</span>
      </button>
      <button class="mobile-action-btn" id="mFavBtn">
        <span><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle;color:#f26a1b"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg> View Favourites</span>
        <span class="pill-badge" id="mFavBadge">0</span>
      </button>
      <button class="mobile-action-btn" id="mSearchBtn">
        <span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg> Search Catalog</span>
        <span>&rarr;</span>
      </button>
    </div>
  </aside>

  <!-- MAIN CONTENT -->
  <main id="top">
    <!-- HERO SECTION WITH SPECIAL ANIMATIONS -->
    <div class="hero" id="hero">
      <!-- Ambient luminous orbs -->
      <div class="hero-orb hero-orb-1" id="heroOrb1"></div>
      <div class="hero-orb hero-orb-2" id="heroOrb2"></div>

      <div class="tag"><span id="season">RE</span><i></i><span>New season</span></div>
      <div class="big" aria-hidden="true">FASHION</div>
      <div class="model" id="model">
        <img id="modelImg" src="Fashion%20Model%20and%20Orange%20Disc%20Cutouts.png"
          alt="Model wearing Fashion+ apparel" onerror="this.parentNode.classList.add('noimg')">
        <span class="ph-text">Add your image at<br>Fashion%20Model%20and%20Orange%20Disc%20Cutouts.png</span>
      </div>
      <div class="copy">
        <h1 id="title">Style in motion</h1>
        <p id="sub">Performance apparel, footwear and gear for a stronger, more confident game.</p>
        <a class="btn" href="#shop">Shop now &rarr;</a>
        <div class="perks"><span>Premium quality</span><span>Free shipping</span><span>Easy returns</span></div>
      </div>
      <div class="thumbs">
        <div id="thumbList"></div>
        <div class="arrows"><button id="prev" aria-label="Previous">&larr;</button><button id="next"
            aria-label="Next">&rarr;</button></div>
      </div>
    </div>

    <!-- CATEGORIES SECTION -->
    <section id="cats">
      <div class="sh">
        <h2>Shop by<br>category</h2>
        <p>Designed for every product. Comfort, performance and style your world now.</p>
      </div>
      <div class="cats" id="catGrid"></div>
    </section>

    <!-- CENTERPIECE FASHION STATEMENT SECTION (CENTER OF PAGE) -->
    <section class="fashion-center-statement" aria-label="Fashion Statement">
      <div class="fashion-center-glow"></div>
      <div class="fashion-center-inner">
        <span class="fashion-kicker">The New Era of Athletic Luxury</span>
        <h2 class="fashion-mega-title">FASHION</h2>
        <div class="fashion-divider-ornament">
          <span></span>
          <i></i>
          <span></span>
        </div>
        <p class="fashion-tagline">
          Engineered for motion, sculpted for expression. Discover the convergence of high-performance discipline and visionary street couture.
        </p>
      </div>
    </section>

    <!-- PRODUCTS / SHOP SECTION -->
    <section id="shop">
      <div class="sh">
        <h2>New arrivals</h2>
        <p id="results">Showing all products</p>
      </div>
      <div class="chips" id="chips"></div>
      <div class="grid" id="grid"></div>
    </section>

    <!-- ABOUT SECTION -->
    <section id="about" style="padding-top:0">
      <div class="sh">
        <h2>About us</h2>
        <p>NOSTRA+ builds sportswear that moves with you, from the court to the street.</p>
      </div>
    </section>

    <!-- NEWSLETTER -->
    <div class="news">
      <h2>Join the new world</h2>
      <div><input id="email" type="email" placeholder="Your email" aria-label="Email"><button class="btn"
          id="sub-btn">Subscribe</button></div>
    </div>
  </main>

  <footer>
    <span>&copy; 2026 NOSTRA+ New World</span>
    <span>Privacy &middot; Terms &middot; Support</span>
  </footer>

  <a class="contact" href="#about" id="contact">CONTACT US</a>
  <div class="toast" id="toast"></div>

  <!-- SCRIPT -->
  <script>
    // HERO SECTION SLIDES (EXACT DATA & MECHANICS PRESERVED)
    const slides = [
      { t: "Style in motion", s: "Performance apparel, footwear and gear for a stronger, more confident game.", c: "#f26a1b", k: "RE", img: "Fashion%20Model%20and%20Orange%20Disc%20Cutouts.png", bg: "g.jpg" },
      { t: "Court ready", s: "Lightweight layers built for long rallies and quick changes.", c: "#0f7f74", k: "NEW", img: "green (2).png", bg: "green (1).png" },
      { t: "Sun on your side", s: "Sunglasses with sharp lenses and frames that stay put.", c: "#c9892b", k: "UV", img: "iii.png", bg: "i.jpg_2K_20261017150142.jpg" }
    ];

    const svgs = {
      women: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3l3 2 3-2 3 7-2 11H8L6 10z"/><path d="M10 5a2 2 0 0 0 4 0"/></svg>`,
      men: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>`,
      sunglass: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="14" r="4"/><circle cx="18" cy="14" r="4"/><path d="M10 14h4"/><path d="M3.5 10.5 5 14"/><path d="M20.5 10.5 19 14"/></svg>`,
      footwear: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2 17h20v3H2z"/><path d="M4 17V8l4-2h5l3 5 4 1v5"/></svg>`,
      accessories: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9h12v11a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V9Z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg>`,
      flower: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 2a4 4 0 0 0 0 8 4 4 0 0 0 0-8Z"/><path d="M12 14a4 4 0 0 0 0 8 4 4 0 0 0 0-8Z"/><path d="M2 12a4 4 0 0 0 8 0 4 4 0 0 0-8 0Z"/><path d="M14 12a4 4 0 0 0 8 0 4 4 0 0 0-8 0Z"/></svg>`
    };

    const cats = [
      ["Women", "#f26a1b", svgs.women],
      ["Men", "#0f7f74", svgs.men],
      ["Sunglass", "#c9892b", svgs.sunglass],
      ["Footwear", "#d94a5b", svgs.footwear],
      ["Accessories", "#3a5bd9", svgs.accessories]
    ];

    const prods = [
      ["Court Dress", "Women", 64, svgs.women],
      ["Print Sundress", "Women", 58, svgs.flower],
      ["Rally Tee", "Men", 32, svgs.men],
      ["Track Jacket", "Men", 78, svgs.men],
      ["Aviator Shades", "Sunglass", 45, svgs.sunglass],
      ["Round Shades", "Sunglass", 39, svgs.sunglass],
      ["Court Sneakers", "Footwear", 92, svgs.footwear],
      ["Weekend Tote", "Accessories", 36, svgs.accessories]
    ];

    const categoryGradients = {
      "Women": "linear-gradient(135deg, #ffece2 0%, #ffd7c7 100%)",
      "Men": "linear-gradient(135deg, #e4f5f3 0%, #c8ede8 100%)",
      "Sunglass": "linear-gradient(135deg, #fdf4e4 0%, #fae6c3 100%)",
      "Footwear": "linear-gradient(135deg, #fde9ec 0%, #fad2d9 100%)",
      "Accessories": "linear-gradient(135deg, #ebf0fd 0%, #d8e2fa 100%)"
    };

    let i = 0;
    let filter = "All";

    // Cart state
    let cart = [];
    try {
      const savedCart = localStorage.getItem("fplus_cart");
      if (savedCart) cart = JSON.parse(savedCart);
    } catch(e) {}

    // Favourites state
    let favourites = new Set();
    try {
      const savedFavs = localStorage.getItem("fplus_favs");
      if (savedFavs) favourites = new Set(JSON.parse(savedFavs));
    } catch(e) {}

    // User session state
    let currentUser = null;
    try {
      const savedUser = localStorage.getItem("fplus_user");
      if (savedUser) currentUser = JSON.parse(savedUser);
    } catch(e) {}

    const $ = id => document.getElementById(id);

    // Toast notification
    function toast(m) {
      const t = $("toast");
      t.textContent = m;
      t.classList.add("show");
      clearTimeout(t._h);
      t._h = setTimeout(() => t.classList.remove("show"), 2400);
    }

    // Celebration confetti
    function launchCelebration() {
      const count = 30;
      for (let j = 0; j < count; j++) {
        const p = document.createElement("div");
        p.className = "auth-confetti";
        p.style.left = (Math.random() * 80 + 10) + "vw";
        p.style.top = (Math.random() * 30 + 10) + "vh";
        p.style.backgroundColor = ["#f26a1b", "#0f7f74", "#ffd166", "#e11d48", "#3a5bd9"][Math.floor(Math.random() * 5)];
        p.style.transform = `rotate(${Math.random() * 360}deg)`;
        document.body.appendChild(p);
        setTimeout(() => p.remove(), 1200);
      }
    }

    // =========================================================
    // 1. SCROLL PROGRESS & MOUSE MOVING FOLLOWER
    // =========================================================
    const mouseGlow = $("mouseGlowFollower");
    const progressBar = $("scrollProgressBar");
    let mouseX = window.innerWidth / 2;
    let mouseY = window.innerHeight / 2;
    let currentX = mouseX;
    let currentY = mouseY;

    window.addEventListener("mousemove", (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
    });

    function animateMouseGlow() {
      currentX += (mouseX - currentX) * 0.12;
      currentY += (mouseY - currentY) * 0.12;
      if (mouseGlow) {
        mouseGlow.style.transform = `translate(${currentX}px, ${currentY}px) translate(-50%, -50%)`;
      }
      requestAnimationFrame(animateMouseGlow);
    }
    animateMouseGlow();

    function handleScrollAndProgress() {
      const header = $("mainHeader");
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;

      if (progressBar) {
        progressBar.style.width = `${progress}%`;
      }

      if (scrollTop > 35) {
        header.classList.add("scrolled");
      } else {
        header.classList.remove("scrolled");
      }
    }
    window.addEventListener("scroll", handleScrollAndProgress, { passive: true });
    handleScrollAndProgress();

    // =========================================================
    // 2. HERO SECTION: SPECIAL 3D PARALLAX & ANIMATIONS
    // =========================================================
    const heroEl = $("hero");
    const modelContainer = $("model");
    const bigTextEl = document.querySelector(".big");
    const copyEl = document.querySelector(".copy");

    heroEl.addEventListener("mousemove", (e) => {
      const rect = heroEl.getBoundingClientRect();
      const normX = (e.clientX - rect.left) / rect.width - 0.5;
      const normY = (e.clientY - rect.top) / rect.height - 0.5;

      if (modelContainer) {
        modelContainer.style.transform = `translateX(-50%) translate3d(${normX * 24}px, ${normY * 12}px, 0) rotateY(${normX * 10}deg) rotateX(${-normY * 6}deg)`;
      }
      if (bigTextEl) {
        bigTextEl.style.transform = `translate3d(${-normX * 36}px, ${-normY * 18}px, 0)`;
      }
      if (copyEl) {
        copyEl.style.transform = `translate3d(${normX * 12}px, ${normY * 8}px, 0)`;
      }
    });

    heroEl.addEventListener("mouseleave", () => {
      if (modelContainer) {
        modelContainer.style.transform = "translateX(-50%) translate3d(0, 0, 0) rotateY(0deg) rotateX(0deg)";
      }
      if (bigTextEl) {
        bigTextEl.style.transform = "translate3d(0, 0, 0)";
      }
      if (copyEl) {
        copyEl.style.transform = "translate3d(0, 0, 0)";
      }
    });

    function show(n) {
      i = (n + slides.length) % slides.length;
      const s = slides[i];

      const titleEl = $("title");
      const subEl = $("sub");
      const seasonEl = $("season");
      const im = $("modelImg");

      titleEl.classList.remove("slide-enter-text");
      subEl.classList.remove("slide-enter-text");
      seasonEl.classList.remove("slide-enter-text");
      im.classList.remove("slide-enter-model");

      void titleEl.offsetWidth;

      titleEl.textContent = s.t;
      subEl.textContent = s.s;
      seasonEl.textContent = s.k;

      titleEl.classList.add("slide-enter-text");
      subEl.classList.add("slide-enter-text");
      seasonEl.classList.add("slide-enter-text");
      im.classList.add("slide-enter-model");

      $("hero").style.setProperty("--c1", s.c);
      $("hero").style.backgroundImage = 'url("' + s.bg + '")';

      const m = $("model");
      m.classList.remove("noimg");
      im.src = s.img;
      m.querySelector(".ph-text").innerHTML = "Add your image at<br>" + s.img;

      const orb1 = $("heroOrb1");
      if (orb1) orb1.style.backgroundColor = s.c;

      document.querySelectorAll(".thumb").forEach((e, j) => e.classList.toggle("on", j === i));
    }

    $("thumbList").style.cssText = "display:flex;flex-direction:column;gap:10px";
    $("prev").onclick = () => { show(i - 1); reset(); };
    $("next").onclick = () => { show(i + 1); reset(); };

    let timer;
    function reset() {
      clearInterval(timer);
      timer = setInterval(() => show(i + 1), 3500);
    }
    if (!matchMedia("(prefers-reduced-motion:reduce)").matches) reset();
    show(0);

    // Categories
    cats.forEach(([n, c, ico]) => {
      const a = document.createElement("a");
      a.className = "cat";
      a.href = "#shop";
      a.style.background = c;
      a.innerHTML = `<span style="margin-right:8px">${ico}</span> ${n}`;
      a.onclick = () => setFilter(n);
      $("catGrid").appendChild(a);
    });

    function setFilter(f) {
      filter = f;
      render();
    }

    // =========================================================
    // 3. AUTHENTICATION & USER PROFILE DASHBOARD
    // =========================================================
    function updateUserUI() {
      const userBtn = $("userBtn");
      const mAccountLabel = $("mAccountLabel");
      const mAccountBadge = $("mAccountBadge");

      if (currentUser) {
        // Signed in state
        userBtn.innerHTML = `<span class="user-avatar-badge">${currentUser.initials}</span>`;
        userBtn.title = `${currentUser.name} (${currentUser.tier})`;

        $("profileName").textContent = currentUser.name;
        $("profileEmail").textContent = currentUser.email;
        $("profileAvatar").textContent = currentUser.initials;
        $("profilePoints").textContent = `${currentUser.points} pts`;
        $("profileTierBadge").textContent = currentUser.tier;

        if (mAccountLabel) mAccountLabel.textContent = currentUser.name;
        if (mAccountBadge) mAccountBadge.textContent = currentUser.tier;
      } else {
        // Logged out state
        userBtn.innerHTML = "&#9786;";
        userBtn.title = "Sign In / Join VIP";

        if (mAccountLabel) mAccountLabel.textContent = "Sign In / Join VIP";
        if (mAccountBadge) mAccountBadge.textContent = "VIP";
      }
    }

    function openAuthModal(defaultTab = "signIn") {
      $("authModal").classList.add("open");
      $("authModal").setAttribute("aria-hidden", "false");
      closeProfileDrawer();
      closeCartDrawer();
      closeFavDrawer();
      closeSearchModal();
      closeMobileMenu();

      if (defaultTab === "signUp") {
        setAuthTab("signUp");
      } else {
        setAuthTab("signIn");
      }
    }

    function closeAuthModal() {
      $("authModal").classList.remove("open");
      $("authModal").setAttribute("aria-hidden", "true");
    }

    function openProfileDrawer() {
      $("profileDrawer").classList.add("open");
      $("profileOverlay").classList.add("open");
      closeAuthModal();
      closeCartDrawer();
      closeFavDrawer();
      closeSearchModal();
      closeMobileMenu();
    }

    function closeProfileDrawer() {
      $("profileDrawer").classList.remove("open");
      $("profileOverlay").classList.remove("open");
    }

    function setAuthTab(tab) {
      if (tab === "signIn") {
        $("tabSignIn").classList.add("on");
        $("tabSignUp").classList.remove("on");
        $("signInForm").style.display = "flex";
        $("signUpForm").style.display = "none";
        $("authSubtitle").textContent = "Welcome back to NOSTRA+";
      } else {
        $("tabSignUp").classList.add("on");
        $("tabSignIn").classList.remove("on");
        $("signUpForm").style.display = "flex";
        $("signInForm").style.display = "none";
        $("authSubtitle").textContent = "Create your account for VIP Gold benefits";
      }
    }

    function loginUser(name, email, tier = "VIP Gold", points = 640) {
      const parts = name.trim().split(" ");
      const initials = parts.length > 1
        ? (parts[0][0] + parts[1][0]).toUpperCase()
        : name.slice(0, 2).toUpperCase();

      currentUser = { name, email, initials, tier, points };
      try {
        localStorage.setItem("fplus_user", JSON.stringify(currentUser));
      } catch(e) {}

      updateUserUI();
      launchCelebration();
      toast(`Welcome, ${name}! VIP Gold active.`);
      closeAuthModal();
    }

    function logoutUser() {
      currentUser = null;
      try {
        localStorage.removeItem("fplus_user");
      } catch(e) {}
      updateUserUI();
      closeProfileDrawer();
      toast("You have been signed out.");
    }

    // Toggle button behavior: opens profile if logged in, opens auth if logged out
    $("userBtn").onclick = () => {
      if (currentUser) {
        openProfileDrawer();
      } else {
        openAuthModal("signIn");
      }
    };

    $("closeAuthModal").onclick = closeAuthModal;
    $("authBackdrop").onclick = closeAuthModal;
    $("closeProfile").onclick = closeProfileDrawer;
    $("profileOverlay").onclick = closeProfileDrawer;
    $("profileShopBtn").onclick = () => {
      closeProfileDrawer();
      location.hash = "#shop";
    };
    $("logoutBtn").onclick = logoutUser;

    $("tabSignIn").onclick = () => setAuthTab("signIn");
    $("tabSignUp").onclick = () => setAuthTab("signUp");

    // 1-Click Demo Login
    $("demoLoginBtn").onclick = () => {
      loginUser("Alex Rivera", "alex@nostra.fashion", "VIP Gold", 640);
    };

    // Sign In Form submission
    $("signInForm").onsubmit = (e) => {
      e.preventDefault();
      const email = $("loginEmail").value.trim();
      const pass = $("loginPass").value.trim();
      if (!email || !pass) {
        toast("Please fill in email and password.");
        return;
      }
      const displayName = email.split("@")[0].replace(/[._-]/g, " ").replace(/\b\w/g, c => c.toUpperCase());
      loginUser(displayName, email, "VIP Gold", 520);
    };

    // Sign Up Form submission
    $("signUpForm").onsubmit = (e) => {
      e.preventDefault();
      const name = $("registerName").value.trim();
      const email = $("registerEmail").value.trim();
      const pass = $("registerPass").value.trim();
      if (!name || !email || pass.length < 6) {
        toast("Please enter your name, email and password (6+ chars).");
        return;
      }
      loginUser(name, email, "VIP Gold", 200);
      toast(`Account created! +200 Welcome VIP points added.`);
    };

    // Toggle password visibility
    $("toggleLoginPass").onclick = () => {
      const inp = $("loginPass");
      inp.type = inp.type === "password" ? "text" : "password";
    };
    $("toggleRegisterPass").onclick = () => {
      const inp = $("registerPass");
      inp.type = inp.type === "password" ? "text" : "password";
    };

    // Password strength indicator
    $("registerPass").addEventListener("input", (e) => {
      const val = e.target.value;
      const fill = $("passStrength");
      if (!val) {
        fill.style.width = "0%";
      } else if (val.length < 6) {
        fill.style.width = "30%";
        fill.style.backgroundColor = "#e11d48";
      } else if (val.length < 10) {
        fill.style.width = "65%";
        fill.style.backgroundColor = "#f59e0b";
      } else {
        fill.style.width = "100%";
        fill.style.backgroundColor = "#10b981";
      }
    });

    // Forgot password
    $("forgotPassLink").onclick = (e) => {
      e.preventDefault();
      const email = $("loginEmail").value.trim() || "your email";
      toast(`Password reset link sent to ${email}`);
    };

    // Mobile Account Button
    $("mAccountBtn").onclick = () => {
      closeMobileMenu();
      if (currentUser) {
        openProfileDrawer();
      } else {
        openAuthModal("signIn");
      }
    };

    // =========================================================
    // 4. ADD TO CART ANIMATION & SYSTEM
    // =========================================================
    function triggerAddAnimation(sourceBtn, productName) {
      const cartBtn = $("cartBtn");
      if (sourceBtn && cartBtn) {
        const srcRect = sourceBtn.getBoundingClientRect();
        const targetRect = cartBtn.getBoundingClientRect();

        const flyer = document.createElement("div");
        flyer.className = "cart-flyer";
        flyer.innerHTML = "&#128717;";
        flyer.style.left = (srcRect.left + srcRect.width / 2 - 16) + "px";
        flyer.style.top = (srcRect.top + srcRect.height / 2 - 16) + "px";
        document.body.appendChild(flyer);

        requestAnimationFrame(() => {
          flyer.style.transform = `translate(${targetRect.left - srcRect.left}px, ${targetRect.top - srcRect.top}px) scale(0.3) rotate(360deg)`;
          flyer.style.opacity = "0.2";
        });

        setTimeout(() => {
          flyer.remove();
          cartBtn.classList.remove("cart-bump");
          void cartBtn.offsetWidth;
          cartBtn.classList.add("cart-bump");
        }, 650);
      }

      if (sourceBtn) {
        const origText = sourceBtn.innerHTML;
        sourceBtn.classList.add("added");
        sourceBtn.innerHTML = "Added!";
        setTimeout(() => {
          sourceBtn.classList.remove("added");
          sourceBtn.innerHTML = origText;
        }, 1100);
      }

      toast(`${productName} added to cart`);
    }

    function addToCart(name, category, price, icon = svgs.women, sourceBtn = null) {
      const existing = cart.find(item => item.name === name);
      if (existing) {
        existing.qty++;
      } else {
        cart.push({ name, category, price, icon, qty: 1 });
      }
      saveCart();
      triggerAddAnimation(sourceBtn, name);
      updateCartUI();
    }

    function updateCartQty(name, delta) {
      const item = cart.find(i => i.name === name);
      if (!item) return;
      item.qty += delta;
      if (item.qty <= 0) {
        cart = cart.filter(i => i.name !== name);
      }
      saveCart();
      updateCartUI();
    }

    function removeFromCart(name) {
      cart = cart.filter(i => i.name !== name);
      saveCart();
      updateCartUI();
      toast("Item removed from cart");
    }

    function clearCart() {
      if (!cart.length) return;
      cart = [];
      saveCart();
      updateCartUI();
      toast("Cart cleared");
    }

    function saveCart() {
      try {
        localStorage.setItem("fplus_cart", JSON.stringify(cart));
      } catch(e) {}
    }

    function updateCartUI() {
      const totalCount = cart.reduce((acc, item) => acc + item.qty, 0);
      $("count").textContent = totalCount;
      $("cartDrawerCount").textContent = `${totalCount} item${totalCount === 1 ? '' : 's'}`;
      $("mCartBadge").textContent = totalCount;

      const subtotal = cart.reduce((acc, item) => acc + item.price * item.qty, 0);
      $("cartSubtotal").textContent = `$${subtotal.toFixed(2)}`;

      const container = $("cartItems");
      if (!cart.length) {
        container.innerHTML = `
          <div class="empty-drawer">
            <div class="empty-drawer-icon"><svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></div>
            <h4>Your cart is empty</h4>
            <p>Explore our latest performance sportswear and add your favourites!</p>
            <a href="#shop" class="btn" onclick="closeCartDrawer()">Start Shopping &rarr;</a>
          </div>
        `;
        $("cartFooter").style.display = "none";
        return;
      }

      $("cartFooter").style.display = "flex";
      container.innerHTML = "";
      cart.forEach(item => {
        const div = document.createElement("div");
        div.className = "drawer-item";
        div.innerHTML = `
          <div class="item-thumb" style="background:${categoryGradients[item.category] || 'var(--card)'}">
            ${item.icon || svgs.women}
          </div>
          <div class="item-info">
            <h4>${item.name}</h4>
            <p>${item.category}</p>
            <div class="item-price">$${(item.price * item.qty).toFixed(2)}</div>
            <div class="qty-controls">
              <button class="qty-btn qty-minus" aria-label="Decrease">&minus;</button>
              <span class="qty-num">${item.qty}</span>
              <button class="qty-btn qty-plus" aria-label="Increase">&plus;</button>
            </div>
          </div>
          <button class="item-remove" aria-label="Remove item">&times;</button>
        `;
        div.querySelector(".qty-minus").onclick = () => updateCartQty(item.name, -1);
        div.querySelector(".qty-plus").onclick = () => updateCartQty(item.name, 1);
        div.querySelector(".item-remove").onclick = () => removeFromCart(item.name);
        container.appendChild(div);
      });
    }

    function openCartDrawer() {
      updateCartUI();
      $("cartDrawer").classList.add("open");
      $("cartOverlay").classList.add("open");
      closeFavDrawer();
      closeProfileDrawer();
      closeAuthModal();
      closeMobileMenu();
    }

    function closeCartDrawer() {
      $("cartDrawer").classList.remove("open");
      $("cartOverlay").classList.remove("open");
    }

    $("cartBtn").onclick = openCartDrawer;
    $("closeCart").onclick = closeCartDrawer;
    $("cartOverlay").onclick = closeCartDrawer;
    $("clearCartBtn").onclick = clearCart;
    $("checkoutBtn").onclick = () => {
      if (!cart.length) return;
      toast("Thank you for your order! Checkout simulated successfully.");
      clearCart();
      closeCartDrawer();
    };

    // =========================================================
    // 5. FAVOURITES (WISHLIST) SYSTEM
    // =========================================================
    function toggleFavourite(name, category, price, icon = svgs.women, btnElement = null) {
      if (favourites.has(name)) {
        favourites.delete(name);
        if (btnElement) {
          btnElement.classList.remove("active");
          btnElement.innerHTML = "&#9825;";
        }
        toast(`${name} removed from favourites`);
      } else {
        favourites.add(name);
        if (btnElement) {
          btnElement.classList.add("active");
          btnElement.classList.add("pop");
          btnElement.innerHTML = "&#9829;";
          setTimeout(() => btnElement.classList.remove("pop"), 400);
        }
        toast(`${name} saved to favourites`);
      }
      saveFavourites();
      updateFavouritesUI();
      document.querySelectorAll(`.fav-btn[data-name="${name}"]`).forEach(b => {
        b.classList.toggle("active", favourites.has(name));
        b.innerHTML = favourites.has(name) ? "&#9829;" : "&#9825;";
      });
    }

    function saveFavourites() {
      try {
        localStorage.setItem("fplus_favs", JSON.stringify(Array.from(favourites)));
      } catch(e) {}
    }

    function updateFavouritesUI() {
      const count = favourites.size;
      $("favCount").textContent = count;
      $("favDrawerCount").textContent = `${count} item${count === 1 ? '' : 's'}`;
      $("mFavBadge").textContent = count;

      const container = $("favItems");
      if (!count) {
        container.innerHTML = `
          <div class="empty-drawer">
            <div class="empty-drawer-icon"><svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></div>
            <h4>No favourites yet</h4>
            <p>Tap the heart icon on any product to save it here for quick access!</p>
            <a href="#shop" class="btn" onclick="closeFavDrawer()">Explore Styles &rarr;</a>
          </div>
        `;
        return;
      }

      container.innerHTML = "";
      favourites.forEach(name => {
        const prodData = prods.find(p => p[0] === name);
        const category = prodData ? prodData[1] : "Apparel";
        const price = prodData ? prodData[2] : 50;
        const icon = prodData ? prodData[3] : svgs.women;

        const div = document.createElement("div");
        div.className = "drawer-item";
        div.innerHTML = `
          <div class="item-thumb" style="background:${categoryGradients[category] || 'var(--card)'}">
            ${icon}
          </div>
          <div class="item-info">
            <h4>${name}</h4>
            <p>${category}</p>
            <div class="item-price">$${price}</div>
            <button class="btn btn-fav-add" style="padding:6px 14px;font-size:11px;margin-top:6px">Add to Cart</button>
          </div>
          <button class="item-remove" aria-label="Remove favourite">&times;</button>
        `;
        div.querySelector(".btn-fav-add").onclick = (e) => {
          addToCart(name, category, price, icon, e.target);
        };
        div.querySelector(".item-remove").onclick = () => {
          toggleFavourite(name, category, price, icon);
        };
        container.appendChild(div);
      });
    }

    function openFavDrawer() {
      updateFavouritesUI();
      $("favDrawer").classList.add("open");
      $("favOverlay").classList.add("open");
      closeCartDrawer();
      closeProfileDrawer();
      closeAuthModal();
      closeMobileMenu();
    }

    function closeFavDrawer() {
      $("favDrawer").classList.remove("open");
      $("favOverlay").classList.remove("open");
    }

    $("favBtn").onclick = openFavDrawer;
    $("closeFav").onclick = closeFavDrawer;
    $("favOverlay").onclick = closeFavDrawer;
    $("clearFavBtn").onclick = () => {
      if (!favourites.size) return;
      favourites.clear();
      saveFavourites();
      updateFavouritesUI();
      render();
      toast("Favourites cleared");
    };
    $("addAllFavToCartBtn").onclick = (e) => {
      if (!favourites.size) {
        toast("No favourites to add");
        return;
      }
      favourites.forEach(name => {
        const p = prods.find(item => item[0] === name);
        if (p) addToCart(p[0], p[1], p[2], p[3], null);
      });
      triggerAddAnimation(e.target, "All favourites");
      openCartDrawer();
    };

    // =========================================================
    // 6. ACTIVE SEARCH SECTION
    // =========================================================
    function openSearchModal() {
      $("searchModal").classList.add("open");
      $("searchModal").setAttribute("aria-hidden", "false");
      $("searchInput").value = "";
      renderSearchResults("");
      setTimeout(() => $("searchInput").focus(), 80);
      closeCartDrawer();
      closeFavDrawer();
      closeProfileDrawer();
      closeAuthModal();
      closeMobileMenu();
    }

    function closeSearchModal() {
      $("searchModal").classList.remove("open");
      $("searchModal").setAttribute("aria-hidden", "true");
    }

    function renderSearchResults(query) {
      const q = query.trim().toLowerCase();
      const list = prods.filter(p => {
        if (!q) return true;
        return p[0].toLowerCase().includes(q) || p[1].toLowerCase().includes(q);
      });

      const container = $("searchResults");
      if (!list.length) {
        container.innerHTML = `
          <div style="text-align:center;padding:30px 10px;color:var(--mute)">
            <p style="font-size:14px;margin-bottom:6px">No products found matching <strong>"${query}"</strong></p>
            <small>Try searching for Women, Men, Sunglasses, or Shoes</small>
          </div>
        `;
        return;
      }

      container.innerHTML = "";
      list.forEach(p => {
        const row = document.createElement("div");
        row.className = "search-result-row";
        row.innerHTML = `
          <div class="search-res-left">
            <div class="search-res-icon" style="background:${categoryGradients[p[1]] || 'var(--card)'}">
              ${p[3]}
            </div>
            <div class="search-res-info">
              <h5>${p[0]}</h5>
              <p>${p[1]}</p>
            </div>
          </div>
          <div class="search-res-right">
            <span class="search-res-price">$${p[2]}</span>
            <button class="search-res-btn">Add to Cart</button>
          </div>
        `;
        row.querySelector(".search-res-btn").onclick = (e) => {
          e.stopPropagation();
          addToCart(p[0], p[1], p[2], p[3], e.target);
        };
        row.onclick = () => {
          closeSearchModal();
          setFilter(p[1]);
          location.hash = "#shop";
        };
        container.appendChild(row);
      });
    }

    $("searchBtn").onclick = openSearchModal;
    $("searchClose").onclick = closeSearchModal;
    $("searchBackdrop").onclick = closeSearchModal;
    $("searchClear").onclick = () => {
      $("searchInput").value = "";
      $("searchInput").focus();
      renderSearchResults("");
    };

    $("searchInput").addEventListener("input", (e) => {
      renderSearchResults(e.target.value);
    });

    document.querySelectorAll(".search-tag-chip").forEach(chip => {
      chip.onclick = () => {
        const q = chip.dataset.q;
        $("searchInput").value = q;
        renderSearchResults(q);
      };
    });

    // =========================================================
    // 7. MOBILE MENU SYSTEM
    // =========================================================
    function toggleMobileMenu() {
      const isOpen = $("mobileDrawer").classList.toggle("open");
      $("mobileOverlay").classList.toggle("open", isOpen);
      $("menuBtn").classList.toggle("active", isOpen);
    }

    function closeMobileMenu() {
      $("mobileDrawer").classList.remove("open");
      $("mobileOverlay").classList.remove("open");
      $("menuBtn").classList.remove("active");
    }

    $("menuBtn").onclick = toggleMobileMenu;
    $("closeMobileMenu").onclick = closeMobileMenu;
    $("mobileOverlay").onclick = closeMobileMenu;

    document.querySelectorAll(".mobile-nav-link").forEach(a => {
      a.onclick = () => {
        if (a.dataset.f) setFilter(a.dataset.f);
        document.querySelectorAll(".mobile-nav-link").forEach(l => l.classList.remove("on"));
        a.classList.add("on");
        closeMobileMenu();
      };
    });

    $("mCartBtn").onclick = () => {
      closeMobileMenu();
      openCartDrawer();
    };

    $("mFavBtn").onclick = () => {
      closeMobileMenu();
      openFavDrawer();
    };

    $("mSearchBtn").onclick = () => {
      closeMobileMenu();
      openSearchModal();
    };

    // Close drawers on Escape key
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        closeCartDrawer();
        closeFavDrawer();
        closeSearchModal();
        closeAuthModal();
        closeProfileDrawer();
        closeMobileMenu();
      }
    });

    // =========================================================
    // 8. PRODUCT GRID RENDER & CHIPS
    // =========================================================
    function render() {
      $("chips").innerHTML = "";
      ["All", ...cats.map(c => c[0])].forEach(f => {
        const b = document.createElement("button");
        b.className = "chip" + (f === filter ? " on" : "");
        b.textContent = f;
        b.onclick = () => setFilter(f);
        $("chips").appendChild(b);
      });

      const list = prods.filter(p => filter === "All" || p[1] === filter);
      $("results").textContent = list.length
        ? `Showing ${list.length} product${list.length > 1 ? "s" : ""}`
        : "No products found. Try another category.";

      $("grid").innerHTML = "";
      list.forEach(p => {
        const isFav = favourites.has(p[0]);
        const d = document.createElement("div");
        d.className = "card";
        d.innerHTML = `
          <div class="ph" style="background:${categoryGradients[p[1]] || 'var(--card)'}">
            <button class="fav-btn ${isFav ? 'active' : ''}" data-name="${p[0]}" aria-label="Favourite ${p[0]}">
              ${isFav ? '&#9829;' : '&#9825;'}
            </button>
            <div class="card-icon">${p[3]}</div>
            <div class="card-category-tag">${p[1]}</div>
          </div>
          <h3>${p[0]}</h3>
          <span>${p[1]} &middot; $${p[2]}</span>
          <button class="add">Add to cart</button>
        `;

        d.querySelector(".add").onclick = (e) => {
          addToCart(p[0], p[1], p[2], p[3], e.target);
        };

        const favBtn = d.querySelector(".fav-btn");
        favBtn.onclick = (e) => {
          e.stopPropagation();
          toggleFavourite(p[0], p[1], p[2], p[3], favBtn);
        };

        $("grid").appendChild(d);
      });
    }

    render();
    updateCartUI();
    updateFavouritesUI();
    updateUserUI();

    document.querySelectorAll("nav a[data-f]").forEach(a => {
      a.onclick = () => {
        setFilter(a.dataset.f);
      };
    });

    document.querySelectorAll("nav a").forEach(a => {
      a.addEventListener("click", () => {
        document.querySelectorAll("nav a").forEach(x => x.classList.remove("on"));
        a.classList.add("on");
      });
    });

    // Newsletter
    $("sub-btn").onclick = () => {
      const v = $("email").value;
      if (/\S+@\S+\.\S+/.test(v)) {
        toast("Subscribed to NOSTRA+ newsletter!");
        $("email").value = "";
      } else {
        toast("Please enter a valid email address");
      }
    };
  </script>
</body>

</html>